#!/usr/bin/python3
"""Build the clipboard-safe native controls for this exact host Qt, offline."""
import fcntl
import hashlib
import os
from pathlib import Path
import platform
import shlex
import shutil
import stat
import subprocess
import tempfile

source = Path(__file__).resolve().parents[1] / "native" / "inputs.cpp"
def output(*args):
    return subprocess.check_output(args, text=True, timeout=15).strip()
for tool in ("g++", "pkg-config"):
    if not shutil.which(tool):
        raise SystemExit("Clipboard-safe inputs require gcc and pkgconf. Install them, then restart the shell.")
version = output("pkg-config", "--modversion", "Qt6Quick")
include = Path(output("pkg-config", "--variable=includedir", "Qt6Core"))
qtlib = Path(output("pkg-config", "--variable=libdir", "Qt6Core")) / "libQt6Quick.so"
qt_stat = qtlib.stat()
key = hashlib.sha256(source.read_bytes() + Path(__file__).read_bytes() +
    f"{version}:{platform.machine()}:{qt_stat.st_size}:{qt_stat.st_mtime_ns}".encode()).hexdigest()
cache_home = Path(os.environ.get("XDG_CACHE_HOME", ""))
if not cache_home.is_absolute(): cache_home = Path.home() / ".cache"
cache_home.mkdir(parents=True, exist_ok=True)
cache = cache_home / "omawhatsapp-inputs"
try: cache.mkdir(mode=0o700)
except FileExistsError: pass
st = cache.lstat()
if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
    raise SystemExit("The native input cache must be a private, owned directory.")
lockfd = os.open(cache / "build.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
with os.fdopen(lockfd, "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    target = cache / key
    module = target / "OmaWhatsApp" / "Inputs"
    if not (module / "libomainputs.so").is_file():
        temp = Path(tempfile.mkdtemp(prefix="build-", dir=cache))
        try:
            out = temp / "OmaWhatsApp" / "Inputs"
            out.mkdir(parents=True)
            copied = temp / "inputs.cpp"
            shutil.copyfile(source, copied)
            flags = shlex.split(output("pkg-config", "--cflags", "Qt6Quick"))
            for component in ("QtCore", "QtGui", "QtQml", "QtQmlModels", "QtQuick"):
                flags += ["-I" + str(include / component / version),
                          "-I" + str(include / component / version / component)]
            moc = Path(output("pkg-config", "--variable=libexecdir", "Qt6Core")) / "moc"
            subprocess.run([str(moc), *flags, str(copied), "-o", str(temp / "inputs.moc")], check=True, timeout=30)
            libs = shlex.split(output("pkg-config", "--libs", "Qt6Quick"))
            subprocess.run(["g++", "-std=c++17", "-shared", "-fPIC", "-O2", "-Wl,-z,defs", *flags,
                str(copied), "-o", str(out / "libomainputs.so"), *libs], check=True, timeout=90)
            (out / "qmldir").write_text("module OmaWhatsApp.Inputs\nplugin omainputs\n")
            copied.unlink()
            (temp / "inputs.moc").unlink()
            os.rename(temp, target)
        finally:
            if temp.exists(): shutil.rmtree(temp)
print(target)
