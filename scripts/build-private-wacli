#!/usr/bin/python3
"""Build the audited private-stdin extension from an exact local upstream checkout.

No download or installation: the caller provides the source and output path.
"""
import argparse
import os
from pathlib import Path
import subprocess
import tarfile
import tempfile

BASE = "b87e6178b7b1e571ce2821ab516039cfa0c6ecf6"
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument("source",type=Path)
parser.add_argument("output",type=Path)
parser.add_argument("--test",action="store_true")
args=parser.parse_args()
source=args.source.resolve();destination=args.output.resolve()
head=subprocess.check_output(["git","-C",str(source),"rev-parse","HEAD"],text=True).strip()
if head!=BASE:raise SystemExit("Expected the audited wacli 0.19.0 commit "+BASE)
patch=Path(__file__).resolve().parents[1]/"dependencies/wacli-private-input.patch"
with tempfile.TemporaryDirectory(prefix="omawhatsapp-wacli-") as temp:
 root=Path(temp)
 archive=root/"source.tar"
 with archive.open("wb") as out:subprocess.run(["git","-C",str(source),"archive",BASE],stdout=out,check=True)
 with tarfile.open(archive) as tar:tar.extractall(root,filter="data")
 archive.unlink()
 subprocess.run(["git","apply","--unidiff-zero",str(patch)],cwd=root,check=True)
 env=dict(os.environ,CGO_ENABLED="1",CGO_CFLAGS="-Wno-error=missing-braces")
 if args.test:
  for command in (["go","test","./..."],["go","test","-tags","sqlite_fts5","./..."],["go","vet","./..."]):
   subprocess.run(command,cwd=root,env=env,check=True,timeout=900)
 subprocess.run(["go","build","-trimpath","-buildvcs=false","-tags","sqlite_fts5","-ldflags=-s -w","-o",str(root/"wacli"),"./cmd/wacli"],cwd=root,env=env,check=True,timeout=900)
 subprocess.run([str(root/"wacli"),"--private-args-version"],check=True)
 destination.parent.mkdir(parents=True,exist_ok=True)
 # copy rather than retaining any source or generated credentials/state
 import shutil
 shutil.copyfile(root/"wacli",destination);destination.chmod(0o755)
 print(destination)
