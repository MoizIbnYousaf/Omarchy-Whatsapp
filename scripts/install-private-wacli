#!/usr/bin/python3
"""Explicitly verify/install a downloaded archive against commit-pinned hashes."""
import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import platform
import stat
import tarfile
import tempfile

PIN = Path(__file__).resolve().parents[1] / "dependencies/wacli-prebuilt.json"
MAX_ARCHIVE = 64 * 1024 * 1024
MAX_BINARY = 64 * 1024 * 1024


def verified_binary(archive, pin):
    with open(archive, "rb") as handle:
        data = handle.read(MAX_ARCHIVE + 1)
    if len(data) > MAX_ARCHIVE or hashlib.sha256(data).hexdigest() != pin["archive_sha256"]:
        raise ValueError("Archive does not match the digest pinned in this reviewed checkout.")
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as bundle:
        members = bundle.getmembers()
        expected = {"wacli", "LICENSE.wacli", "wacli-provenance.json"}
        names = [m.name.removeprefix("./") for m in members]
        if len(names) != len(expected) or set(names) != expected or any(not m.isfile() for m in members):
            raise ValueError("Unexpected archive contents.")
        member = members[names.index("wacli")]
        if member.size > MAX_BINARY:
            raise ValueError("Binary exceeds the size limit.")
        binary = bundle.extractfile(member).read(MAX_BINARY + 1)
    if hashlib.sha256(binary).hexdigest() != pin["binary_sha256"]:
        raise ValueError("Binary does not match the digest pinned in this reviewed checkout.")
    return binary


def install(binary, target):
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_symlink() or (target.exists() and not target.is_file()):
        raise ValueError("Refusing to replace a symlink or non-regular executable.")
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(prefix=".wacli-", dir=target.parent, delete=False) as handle:
            temporary = handle.name
            handle.write(binary)
            handle.flush()
            os.fsync(handle.fileno())
            os.fchmod(handle.fileno(), 0o755)
        os.replace(temporary, target)
        temporary = None
    finally:
        if temporary is not None:
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("archive", type=Path)
    parser.add_argument("--verify-only", action="store_true")
    args = parser.parse_args()
    if platform.system() != "Linux" or platform.machine() not in {"x86_64", "amd64"}:
        parser.error("This prebuilt artifact is for Linux x86-64; use the pinned source build.")
    try:
        pin = json.loads(PIN.read_text())
        binary = verified_binary(args.archive, pin)
        if not args.verify_only:
            install(binary, Path.home() / ".local/bin/wacli")
    except (OSError, ValueError, tarfile.TarError) as exc:
        parser.exit(1, f"Verification/install failed: {exc}\n")
    print("Verified commit-pinned archive and binary" + ("; installed wacli." if not args.verify_only else "."))


if __name__ == "__main__":
    main()
