#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

for command_name in make qmllint jq omarchy rg; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "test: missing command: $command_name" >&2
    exit 1
  }
done

qml_test_runner=/usr/lib/qt6/bin/qmltestrunner
[[ -x $qml_test_runner ]] || {
  echo "test: Qt 6 qmltestrunner is missing: $qml_test_runner" >&2
  exit 1
}

make validate
./scripts/install --check
./scripts/check-wacli-parity
for qml_test in tests/tst_keyboard_navigation.qml tests/tst_media_viewer.qml tests/tst_dropdown_model.qml tests/tst_settings_policy.qml; do
  QT_QPA_PLATFORM=offscreen "$qml_test_runner" \
    -input "$qml_test" \
    -import "$repo_root/tests/imports" \
    -import "$repo_root/plugins/omawhatsapp" \
    -o -,txt
done

bash -n scripts/install scripts/test scripts/uninstall
python3 -m py_compile scripts/check-wacli-parity
git diff --check

jq -e '.id == "io.github.moizibnyousaf.omawhatsapp"' \
  manifest.json plugins/omawhatsapp/manifest.json >/dev/null || {
  echo "test: public plugin ID must remain globally namespaced" >&2
  exit 1
}

rg -q 'systemctl --user restart "\$unit"' scripts/install || {
  echo "test: installer upgrades must activate the new sync unit" >&2
  exit 1
}
rg -q 'wacli-sync@\$\{account_name\}\.service' scripts/install || {
  echo "test: installer must activate one sync instance per named account" >&2
  exit 1
}
rg -q 'ExecCondition=%h/\.local/bin/omawhatsapp session-ready --account %i' \
  systemd/user/wacli-sync@.service || {
  echo "test: the sync template must skip an account with no linked session" >&2
  exit 1
}

rg -q 'install_plugin_dir=\$plugin_id' scripts/install || {
  echo "test: installer must target Omarchy's canonical manifest-id directory" >&2
  exit 1
}
rg -q 'plugin_root/\$install_plugin_dir.*plugin_root/\$source_plugin_dir' scripts/install || {
  echo "test: installer must remove the exact legacy duplicate directory" >&2
  exit 1
}

for branded_surface in BarWidget.qml Dropdown.qml App.qml; do
  rg -q '󰖣' "plugins/omawhatsapp/$branded_surface" || {
    echo "test: $branded_surface must use the WhatsApp brand mark" >&2
    exit 1
  }
done

rg -q '"setpriv", "--pdeathsig", "TERM"' plugins/omawhatsapp/Service.qml || {
  echo "test: store watcher must die with the Omarchy shell" >&2
  exit 1
}
rg -q 'name === "wacli\.db".*name === "wacli\.db-wal"' \
  plugins/omawhatsapp/Service.qml || {
  echo "test: store watcher must ignore unrelated private-store files" >&2
  exit 1
}

if rg -n 'QtWebEngine|WebEngineView|WebView|node_modules|Electron' \
  --glob '*.qml' --glob '*.js' --glob '*.sh' --glob '*.service' \
  --glob '!scripts/test' .; then
  echo "test: forbidden heavyweight runtime dependency found" >&2
  exit 1
fi

echo "All validation and tests passed."
