#!/usr/bin/env bash
set -euo pipefail

# Arch installs the Qt tools (qmllint, qmltestrunner) outside PATH.
[[ -d /usr/lib/qt6/bin && :$PATH: != *:/usr/lib/qt6/bin:* ]] && PATH="$PATH:/usr/lib/qt6/bin"

repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

for command_name in make qmllint jq omarchy rg; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "test: missing command: $command_name" >&2
    exit 1
  }
done

qml_test_runner=/usr/lib/qt6/bin/qmltestrunner
[[ -x $qml_test_runner ]] || {
  echo "test: Qt 6 qmltestrunner is missing: $qml_test_runner" >&2
  exit 1
}

media_fixture_root="$repo_root/tests/.generated-media"
[[ ! -e $media_fixture_root ]] || {
  echo "test: generated media path already exists: $media_fixture_root" >&2
  exit 1
}
mkdir -- "$media_fixture_root"
plugin_home=$(mktemp -d)
cleanup_test_fixtures() {
  find "$media_fixture_root" -maxdepth 1 -type f -delete
  rmdir -- "$media_fixture_root"
  rm -rf -- "$plugin_home"
}
trap cleanup_test_fixtures EXIT
python3 tests/write_media_fixtures.py "$media_fixture_root"

make validate
./scripts/check-wacli-parity

# What `omarchy plugin add` installs: the repository's files in the plugins
# folder, nothing else. It must validate, and its helper must find itself
# there, with an empty home and no wacli.
checkout="$plugin_home/.config/omarchy/plugins/io.github.moizibnyousaf.omawhatsapp"
mkdir -p -- "$checkout"
git ls-files -z --cached --others --exclude-standard \
  | grep -zv '^tests/\.generated-media/' \
  | while IFS= read -r -d '' file; do
      # Regular files only: a nested checkout (CI keeps Omarchy's source in
      # .omarchy/) is listed as a directory and is not part of the plugin.
      [[ -f $file && ! -L $file ]] || continue
      install -D -m "$(stat -c %a -- "$file")" -- "$file" "$checkout/$file"
    done
omarchy plugin validate "$checkout"
HOME="$plugin_home" XDG_CONFIG_HOME="$plugin_home/.config" XDG_STATE_HOME="$plugin_home/.local/state" \
  WACLI_BIN="$plugin_home/no-wacli" "$checkout/bin/omawhatsapp" status \
  | jq -e --arg root "$checkout" '
      .setup.plugin_root == $root and .setup.units == "missing"
      and .setup.consented == false and .setup.wacli.found == false' >/dev/null || {
  echo "test: the helper in a plugin checkout must find itself and report the setup" >&2
  exit 1
}
printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
  | HOME="$plugin_home" "$checkout/bin/omawhatsapp-mcp" | jq -e '.result.tools | length > 40' >/dev/null
rg -q '^name: omawhatsapp$' skills/omawhatsapp/SKILL.md
rg -q 'references/wacli-parity\.md' skills/omawhatsapp/SKILL.md
! rg -q 'TODO|\[TODO' skills/omawhatsapp
python3 bin/omawhatsapp capabilities \
  | jq -e --arg version "$(sed -nE 's/^WACLI_PARITY_VERSION = "([^"]+)".*/\1/p' bin/omawhatsapp_core.py)" \
    '.ok == true and .wacli_parity_version == $version and .operation_count == 108' >/dev/null
while IFS= read -r -d '' qml_test; do
  QT_QPA_PLATFORM=offscreen "$qml_test_runner" \
    -input "$qml_test" \
    -import "$repo_root/tests/imports" \
    -import "$repo_root/plugins/omawhatsapp" \
    -o -,txt
done < <(find tests -maxdepth 1 -type f -name 'tst_*.qml' -print0 | sort -z)

bash -n scripts/test scripts/dev-sync
python3 -m py_compile bin/omawhatsapp_assets.py scripts/check-wacli-parity scripts/earlier-copies
python3 -m py_compile tests/write_media_fixtures.py
git diff --check

jq -e '.id == "io.github.moizibnyousaf.omawhatsapp"' manifest.json >/dev/null || {
  echo "test: public plugin ID must remain globally namespaced" >&2
  exit 1
}
helper_version=$(sed -nE 's/^HELPER_VERSION = "([^"]+)".*/\1/p' bin/omawhatsapp_core.py)
[[ $helper_version == $(jq -r '.version' manifest.json) ]] || {
  echo "test: HELPER_VERSION in bin/omawhatsapp_core.py must match manifest.json" >&2
  exit 1
}

rg -q 'ExecCondition=%h/\.local/bin/omawhatsapp session-ready --account %i' \
  systemd/user/wacli-sync@.service || {
  echo "test: the sync template must skip an account with no linked session" >&2
  exit 1
}
for sync_unit in systemd/user/wacli-sync.service systemd/user/wacli-sync@.service; do
  rg -q -- '--lock-wait 30s sync --follow' "$sync_unit" || {
    echo "test: $sync_unit must wait for the store lock instead of restarting" >&2
    exit 1
  }
done
rg -q -- '--store %h/\.local/state/wacli' systemd/user/wacli-sync.service || {
  echo "test: the legacy unit must remain pinned to the preserved root store" >&2
  exit 1
}

for branded_surface in BarWidget.qml Dropdown.qml App.qml; do
  rg -q '󰖣' "plugins/omawhatsapp/$branded_surface" || {
    echo "test: $branded_surface must use the WhatsApp brand mark" >&2
    exit 1
  }
done

rg -q '"setpriv", "--pdeathsig", "TERM"' plugins/omawhatsapp/Service.qml || {
  echo "test: store watcher must die with the Omarchy shell" >&2
  exit 1
}
rg -q 'name === "wacli\.db".*name === "wacli\.db-wal"' \
  plugins/omawhatsapp/Service.qml || {
  echo "test: store watcher must ignore unrelated private-store files" >&2
  exit 1
}

if rg -n 'QtWebEngine|WebEngineView|WebView|node_modules|Electron' \
  --glob '*.qml' --glob '*.js' --glob '*.sh' --glob '*.service' \
  --glob '!scripts/test' .; then
  echo "test: forbidden heavyweight runtime dependency found" >&2
  exit 1
fi

echo "All validation and tests passed."
