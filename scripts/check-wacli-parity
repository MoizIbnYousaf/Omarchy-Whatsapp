#!/usr/bin/python3
"""Compare the shipped policy registry with the installed wacli command tree."""

from __future__ import annotations

import importlib.util
from importlib.machinery import SourceFileLoader
from functools import lru_cache
import os
from pathlib import Path
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
HELPER = ROOT / "bin/omawhatsapp"
WACLI = Path(os.environ.get("WACLI_BIN", Path.home() / ".local/bin/wacli"))


def load_helper():
    spec = importlib.util.spec_from_loader(
        "omawhatsapp_parity", SourceFileLoader("omawhatsapp_parity", str(HELPER))
    )
    if spec is None or spec.loader is None:
        raise RuntimeError("could not load OmaWhatsApp helper")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


@lru_cache(maxsize=None)
def help_text(path: tuple[str, ...]) -> str:
    result = subprocess.run(
        [str(WACLI), *path, "--help"],
        text=True,
        capture_output=True,
        timeout=15,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(f"wacli help failed for {' '.join(path) or '<root>'}")
    return result.stdout


def children(path: tuple[str, ...]) -> list[str]:
    output = help_text(path)
    match = re.search(
        r"^Available Commands:\n(.*?)(?=^Flags:|^Global Flags:|^Use \"|\Z)",
        output,
        re.MULTILINE | re.DOTALL,
    )
    if match is None:
        return []
    return [
        line.strip().split()[0]
        for line in match.group(1).splitlines()
        if line.strip()
    ]


def leaves(path: tuple[str, ...] = ()) -> set[tuple[str, ...]]:
    commands = children(path)
    if not commands:
        return {path}
    result: set[tuple[str, ...]] = set()
    for command in commands:
        result.update(leaves((*path, command)))
    return result


def main() -> int:
    if not WACLI.is_file() or not os.access(WACLI, os.X_OK):
        print(f"parity: wacli is not executable: {WACLI}", file=sys.stderr)
        return 1
    helper = load_helper()
    version = subprocess.run(
        [str(WACLI), "--version"],
        text=True,
        capture_output=True,
        timeout=15,
        check=False,
    )
    match = re.fullmatch(
        rf"wacli\s+v?{re.escape(helper.WACLI_PARITY_VERSION)}\s*",
        version.stdout or version.stderr,
    )
    if version.returncode != 0 or match is None:
        print(
            f"parity: requires exactly wacli {helper.WACLI_PARITY_VERSION}",
            file=sys.stderr,
        )
        return 1
    discovered = leaves()
    # `auth` is both an executable QR flow and a parent for status/logout.
    discovered.add(("auth",))
    registered = set(helper.WACLI_OPERATION_POLICIES)
    missing = sorted(discovered - registered)
    stale = sorted(registered - discovered)
    if missing or stale:
        for path in missing:
            print(f"parity: unclassified wacli leaf: {' '.join(path)}", file=sys.stderr)
        for path in stale:
            print(f"parity: registered leaf missing from wacli: {' '.join(path)}", file=sys.stderr)
        return 1
    optional_chat_contract = {
        ("calls", "list"): "--chat",
        ("history", "coverage"): "--chat",
        ("polls", "list"): "--chat",
    }
    contact_contract = {
        ("profile", "business"): "--jid",
        ("profile", "get-about"): "--jid",
        ("profile", "picture-info"): "--jid",
    }
    for path, flag in {**optional_chat_contract, **contact_contract}.items():
        advertised = set(re.findall(r"(?<!\S)(--[a-z0-9-]+)(?:[ =]|$)", help_text(path)))
        if flag not in advertised:
            print(
                f"parity: pinned target flag missing from wacli help: {' '.join(path)} {flag}",
                file=sys.stderr,
            )
            return 1
    for path, flag in optional_chat_contract.items():
        if flag not in helper.WACLI_OPTIONAL_CHAT_FLAGS.get(path, ()):
            print(
                f"parity: optional chat flag is not locally validated: {' '.join(path)} {flag}",
                file=sys.stderr,
            )
            return 1
    for path in contact_contract:
        if path not in helper.WACLI_CONTACT_JID_OPERATIONS:
            print(
                f"parity: contact target is not locally validated: {' '.join(path)}",
                file=sys.stderr,
            )
            return 1
    print(
        f"OmaWhatsApp covers all {len(registered)} wacli "
        f"{helper.WACLI_PARITY_VERSION} command leaves."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
