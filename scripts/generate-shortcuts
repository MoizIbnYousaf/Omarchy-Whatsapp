#!/usr/bin/env python3
"""Generate the Python and QML catalogs from the public shortcut definitions."""
import json
from pathlib import Path
import pprint
import re

root = Path(__file__).resolve().parent.parent
catalog = json.loads((root / 'bin/shortcuts.json').read_text())
(root / 'plugins/omawhatsapp/ShortcutCatalog.js').write_text(
    '.pragma library\n\n// Generated by scripts/generate-shortcuts from bin/shortcuts.json.\nvar actions = '
    + json.dumps(catalog, indent=2) + '\n')
helper = root / 'bin/omawhatsapp_core.py'
text = helper.read_text()
text = re.sub(r'SHORTCUT_CATALOG = .*?\nSHORTCUT_ACTIONS =',
              lambda _: 'SHORTCUT_CATALOG = ' + pprint.pformat(catalog, width=100, sort_dicts=False) + '\nSHORTCUT_ACTIONS =',
              text, count=1, flags=re.S)
helper.write_text(text)
