#!/usr/bin/python3
"""Entry point of the local bridge between OmaWhatsApp and wacli.

The bridge lives in omawhatsapp_core.py beside this file. Imported as a
module, its bytecode is cached, so a call no longer recompiles six thousand
lines first: every send, refresh, and status poll starts about 0.2 s sooner.
"""

import os
import sys

# Compiled files stay out of ~/.local/bin; uninstall removes this folder. A
# relative XDG_CACHE_HOME is invalid and ignored, as the install scripts do.
_cache_home = os.environ.get("XDG_CACHE_HOME", "")
if not os.path.isabs(_cache_home):
    _cache_home = os.path.join(os.path.expanduser("~"), ".cache")
if os.path.isabs(_cache_home):
    sys.pycache_prefix = os.path.join(_cache_home, "omawhatsapp", "pycache")
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from omawhatsapp_core import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
