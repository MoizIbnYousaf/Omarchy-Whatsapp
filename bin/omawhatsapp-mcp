@tool("export_chat", "Export a chat",
      "Write one chat's messages to a JSON file on this computer. The file holds private "
      "messages; save it where the user asked, outside code repositories.",
      {"chat": CHAT, "path": {"type": "string", "description": "Absolute path of the new .json file."},
       "after": DATE, "before": DATE,
       "limit": {"type": "integer", "description": "Default 5000, at most 100000."}},
      ("chat", "path"), kind="write")
def export_chat(chat: str, path: str, after: str = "", before: str = "", limit: int = 5000,
                account: str = "") -> dict[str, Any]:
    target = resolve_chat(chat, account)
    requested = Path(path).expanduser()
    if not requested.is_absolute():
        raise ToolError("path must be absolute.")
    if not requested.parent.is_dir():
        raise ToolError("The folder for that file does not exist.")
    # The helper authorizes the resolved path, so a symlinked folder matches.
    destination = requested.parent.resolve() / requested.name
    if os.path.lexists(destination):
        raise ToolError("A file is already there; choose a new file name.")
    arguments = ["messages", "export", "--chat", target["jid"], "--output", str(destination),
                 "--limit", str(bounded(limit, 5000, 1, 100000))]
    if after:
        arguments += ["--after", rfc3339(after, "after")]
    if before:
        arguments += ["--before", rfc3339(before, "before")]
    gateway(arguments, f"private-export:{destination}", str(target.get("account") or account),
            timeout=300)
    return compact({"done": True, "path": str(destination),
                    "size_bytes": destination.stat().st_size if destination.is_file() else None})


@tool("join_group", "Join a group by link",
      "Join a group from its invite link.",
      {"invite": {"type": "string", "description": "https://chat.whatsapp.com/... link or code."}},
      ("invite",), kind="write")
def join_group(invite: str, account: str = "") -> dict[str, Any]:
    match = INVITE.search(str(invite or "").strip().rstrip("/"))
    if not match:
        raise ToolError("That is not a WhatsApp group invite link.")
    data = gateway(["groups", "join", "--code", match.group(1)], "whatsapp-write", account,
                   timeout=90) or {}
    return compact({"done": True, "jid": data.get("jid") if isinstance(data, dict) else None})


@tool("download_pending_media", "Download missing attachments",
      "Download attachments that are not on this computer yet, in one chat or the most recent "
      "ones overall, beside the live sync. ask_phone also asks the phone to re-send expired "
      "ones, which pauses background sync.",
      {"chat": CHAT, "limit": {"type": "integer", "description": "Default 20, at most 100."},
       "kinds": {"type": "array", "items": {"type": "string", "enum": ATTACHMENT_KINDS}},
       "ask_phone": BOOL}, kind="remote")
def download_pending_media(chat: str = "", limit: int = 20, kinds: list[str] | None = None,
                           ask_phone: bool = False, account: str = "") -> dict[str, Any]:
    payload: dict[str, Any] = {"account": account, "missing_only": True,
                               "kinds": [kind for kind in (kinds or ATTACHMENT_KINDS)
                                         if kind != "location"],
                               "limit": bounded(limit, 20, 1, 100)}
    target = resolve_chat(chat, account) if chat else None
    if target:
        payload["jid"] = target["jid"]
    pending = helper("attachments", payload).get("attachments") or []
    downloaded, failed, expired = 0, [], 0
    for item in pending:
        if item.get("available") is False:
            expired += 1
            continue
        try:
            helper("media", {"account": account, "jid": item["chat_jid"], "id": item["id"]},
                   timeout=240)
            downloaded += 1
        except ToolError as exc:
            # WhatsApp's media server answers 403 once an old file expired there.
            if "403" in str(exc):
                expired += 1
                continue
            failed.append(compact({"chat_name": item.get("chat_name"), "id": item.get("id"),
                                   "error": str(exc)}))
    result: dict[str, Any] = {"downloaded": downloaded, "failed": failed or None,
                              "expired": expired or None}
    if expired and not ask_phone:
        result["hint"] = ("Expired files are no longer on WhatsApp's server; ask_phone: true "
                          "asks the phone to send them again if it still has them.")
    if ask_phone:
        arguments = ["media", "retry", "--limit", str(bounded(limit, 20, 1, 100))]
        if target:
            arguments += ["--chat", target["jid"]]
        result["asked_phone"] = compact(gateway(arguments, "sync", account, timeout=300))
    return compact(result)


# ------------------------------------------------------------------ protocol

def call_tool(name: str, arguments: Any) -> dict[str, Any]:
    entry = TOOLS.get(name)
    if entry is None:
        return {"content": [{"type": "text", "text": f"Unknown tool: {name}"}], "isError": True}
    try:
        values = validate(entry["inputSchema"], arguments)
        result = entry["handler"](**values)
    except ToolError as exc:
        text = str(exc)
        if exc.partial:
            text += "\nPartly done: " + json.dumps(exc.partial, ensure_ascii=False)
        return {"content": [{"type": "text", "text": text}], "isError": True}
    except Exception as exc:  # A tool bug must not take the server down.
        return {"content": [{"type": "text",
                             "text": f"WhatsApp for Omarchy failed unexpectedly ({type(exc).__name__})."}],
                "isError": True}
    return {"content": [{"type": "text",
                         "text": json.dumps(result, ensure_ascii=False, separators=(",", ":"))}],
            "isError": False}


def listed_tools() -> list[dict[str, Any]]:
    return [{key: value for key, value in entry.items() if key != "handler"}
            for entry in TOOLS.values()]


def respond(message: dict[str, Any]) -> dict[str, Any] | None:
    method = message.get("method")
    identifier = message.get("id")
    params = message.get("params") if isinstance(message.get("params"), dict) else {}
    if identifier is None:
        return None  # A notification such as notifications/initialized.
    if method == "initialize":
        requested = str(params.get("protocolVersion") or "")
        result: Any = {
            "protocolVersion": requested if requested in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0],
            "capabilities": {"tools": {"listChanged": False}},
            "serverInfo": {"name": "omawhatsapp", "title": "WhatsApp for Omarchy", "version": VERSION},
            "instructions": INSTRUCTIONS,
        }
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": listed_tools()}
    elif method == "tools/call":
        result = call_tool(str(params.get("name") or ""), params.get("arguments"))
    else:
        return {"jsonrpc": "2.0", "id": identifier,
                "error": {"code": -32601, "message": f"Method not found: {method}"}}
    return {"jsonrpc": "2.0", "id": identifier, "result": result}


def serve(stdin: Any = sys.stdin, stdout: Any = sys.stdout) -> int:
    for line in stdin:
        if not line.strip():
            continue
        try:
            message = json.loads(line)
        except ValueError:
            reply: Any = {"jsonrpc": "2.0", "id": None,
                          "error": {"code": -32700, "message": "Parse error"}}
        else:
            batch = message if isinstance(message, list) else [message]
            replies = [respond(item) if isinstance(item, dict) else
                       {"jsonrpc": "2.0", "id": None,
                        "error": {"code": -32600, "message": "Invalid request"}}
                       for item in batch]
            replies = [item for item in replies if item is not None]
            if not replies:
                continue
            reply = replies if isinstance(message, list) else replies[0]
        stdout.write(json.dumps(reply, ensure_ascii=False) + "\n")
        stdout.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(serve())
