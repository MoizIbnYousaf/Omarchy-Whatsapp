@tool("vote_poll", "Vote in a poll",
      "Vote in a poll with one or more of its option texts exactly as written.",
      {"chat_jid": STRING, "id": MESSAGE, "options": STRINGS},
      ("chat_jid", "id", "options"), kind="write")
def vote_poll(chat_jid: str, id: str, options: list[str], account: str = "") -> dict[str, Any]:
    if not options:
        raise ToolError("Choose at least one option.")
    arguments = ["poll", "vote", "--to", exact_jid(chat_jid, "chat_jid"), "--id", str(id)]
    for option in options:
        arguments += ["--option", option]
    gateway(arguments, "whatsapp-write", account, timeout=90)
    return {"done": True}


@tool("send_location", "Send a location",
      "Send a map pin. To pass on a location someone sent, take latitude and longitude from "
      "that message in read_chat or list_attachments.",
      {"jid": JID, "latitude": {"type": "number"}, "longitude": {"type": "number"},
       "name": {"type": "string", "description": "Place name shown on the pin."}},
      ("jid", "latitude", "longitude"), kind="write")
def send_location(jid: str, latitude: float, longitude: float, name: str = "",
                  account: str = "") -> dict[str, Any]:
    if not (-90 <= latitude <= 90 and -180 <= longitude <= 180):
        raise ToolError("Latitude goes from -90 to 90 and longitude from -180 to 180.")
    arguments = ["send", "location", "--to", exact_jid(jid), "--latitude", repr(float(latitude)),
                 "--longitude", repr(float(longitude)), "--post-send-wait", "0"]
    if name:
        arguments += ["--name", text_argument(name, "name")[:256]]
    gateway(arguments, "whatsapp-write", account, timeout=90)
    return {"done": True}


@tool("update_profile", "Update your profile",
      "Change your WhatsApp name, your about text, or your profile photo. Your contacts see "
      "the change. Pauses background sync briefly.",
      {"name": STRING, "about": STRING,
       "photo_path": {"type": "string", "description": "Absolute path of a JPEG or PNG."}},
      kind="write")
def update_profile(name: str = "", about: str = "", photo_path: str = "",
                   account: str = "") -> dict[str, Any]:
    if not (name or about or photo_path):
        raise ToolError("Choose a name, an about text or a photo.")
    changed = []
    if name:
        gateway(["profile", "set-name", text_argument(name, "name")[:25]], "whatsapp-write",
                account, timeout=60)
        changed.append("name")
    if about:
        try:
            gateway(["profile", "set-about", text_argument(about, "about")[:139]],
                    "whatsapp-write", account, timeout=60)
        except ToolError as exc:
            if "graphql" not in str(exc).lower():
                raise
            # Seen on a WhatsApp Business number: its about lives in the
            # business profile, and WhatsApp refuses this change.
            raise ToolError("WhatsApp refused the about change. WhatsApp Business accounts keep "
                            "it in the business profile, which is edited on the phone."
                            + (f" Already changed: {', '.join(changed)}." if changed else "")) from exc
        changed.append("about")
    if photo_path:
        photo = Path(photo_path).expanduser()
        if not photo.is_file():
            raise ToolError("That photo does not exist.")
        gateway(["profile", "set-picture", str(photo)], "whatsapp-write", account, timeout=120)
        changed.append("photo")
    return {"done": True, "changed": changed}


@tool("post_status", "Post a status",
      "Post a status update (text, or a photo or video with a caption) that your contacts "
      "see for 24 hours. Pauses background sync briefly.",
      {"text": {"type": "string", "description": "Status text, or the caption of the file."},
       "file_path": {"type": "string", "description": "Absolute path of a photo or video."},
       "background_color": {"type": "string", "description": "Text status color, #RRGGBB."}},
      kind="write")
def post_status(text: str = "", file_path: str = "", background_color: str = "",
                account: str = "") -> dict[str, Any]:
    if not (text or file_path):
        raise ToolError("A status needs text or a file.")
    arguments = ["send", "status", "--post-send-wait", "0"]
    if text:
        arguments += ["--message", text_argument(text, "text")]
    if file_path:
        media = Path(file_path).expanduser()
        if not media.is_file():
            raise ToolError("That file does not exist.")
        arguments += ["--file", str(media)]
    if background_color:
        if not re.fullmatch(r"#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})", background_color):
            raise ToolError("background_color must look like #RRGGBB.")
        arguments += ["--background-color", background_color]
    data = gateway(arguments, "whatsapp-write", account, timeout=180) or {}
    return compact({"done": True, "status_id": data.get("id") if isinstance(data, dict) else None,
                    "note": "delete_status with this status_id removes it for everyone."})


