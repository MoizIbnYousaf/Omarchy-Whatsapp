@tool("send_poll", "Send a poll",
      "Send a poll with 2 to 12 options to one existing chat.",
      {"jid": JID, "question": STRING, "options": STRINGS,
       "multiple": {"type": "boolean", "description": "Allow choosing more than one option."}},
      ("jid", "question", "options"), kind="write")
def send_poll(jid: str, question: str, options: list[str], multiple: bool = False,
              account: str = "") -> dict[str, Any]:
    choices = [option.strip() for option in options if option.strip()]
    if not 2 <= len(choices) <= 12:
        raise ToolError("A poll needs 2 to 12 options.")
    answer = helper("poll", {"account": account, "jid": exact_jid(jid),
                             "question": text_argument(question, "question"),
                             "options": choices, "multi": len(choices) if multiple else 1},
                    timeout=90)
    return sent(answer)


CHAT_STATES = ["read", "unread", "pin", "unpin", "archive", "unarchive", "mute", "unmute"]


@tool("set_chat_state", "Organize chats",
      "Mark chats read or unread, pin, archive or mute them, on every linked device. "
      "Several chats at once stop at the first failure.",
      {"jids": {"type": "array", "items": {"type": "string"}, "description": "Exact chat jids, up to 50."},
       "action": {"type": "string", "enum": CHAT_STATES}}, ("jids", "action"), kind="write")
def set_chat_state(jids: list[str], action: str, account: str = "") -> dict[str, Any]:
    if not 1 <= len(jids) <= MAX_BULK:
        raise ToolError(f"Choose 1 to {MAX_BULK} chats.")
    changed: list[str] = []
    for jid in jids:
        try:
            helper("chat-action", {"account": account, "jid": exact_jid(jid), "action": action},
                   timeout=90)
        except ToolError as exc:
            raise ToolError(f"Stopped at {jid}: {exc}. Already changed: "
                            + (", ".join(changed) or "none")) from exc
        changed.append(jid)
    return {"done": True, "changed": len(changed)}


def group_users(values: list[str]) -> list[str]:
    users = []
    for value in values:
        text = str(value or "").strip()
        if "@" in text:
            users.append(exact_jid(text, "participant"))
        elif PHONE.match(text) and 8 <= len(digits_of(text)) <= 15:
            users.append("+" + digits_of(text))
        else:
            raise ToolError(f'"{text}" is not a jid or a full phone number. Use find_contacts.')
    return users


def indexed_chat(jid: str, account: str, wait: float = 20) -> bool:
    """Whether a chat just created on WhatsApp reached the local archive."""
    deadline = time.monotonic() + wait
    while True:
        if any(row.get("jid") == jid for row in all_chats(account)):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(2)


@tool("create_group", "Create a group",
      "Create a WhatsApp group (or a community) with a name and participants, and "
      "optionally a description and admin-only settings. Pauses background sync briefly.",
      {"name": STRING,
       "participants": {"type": "array", "items": {"type": "string"},
                        "description": "Exact jids from find_contacts, or full phone numbers."},
       "description": STRING,
       "announce_only": {"type": "boolean", "description": "Only admins send messages."},
       "locked": {"type": "boolean", "description": "Only admins edit the group info."},
       "join_approval": {"type": "boolean", "description": "Admins approve new members."},
       "community": {"type": "boolean", "description": "Create a community instead of a group."},
       "community_jid": {"type": "string", "description": "Create the group inside this community."}},
      ("name",), kind="write")
def create_group(name: str, participants: list[str] | None = None, description: str = "",
                 announce_only: bool = False, locked: bool = False,
                 join_approval: bool = False, community: bool = False,
                 community_jid: str = "", account: str = "") -> dict[str, Any]:
    title = " ".join(str(name or "").split())
    if not 1 <= len(title) <= 100:
        raise ToolError("A group name needs 1 to 100 characters.")
    users = group_users(participants or [])
    if not users and not community:
        raise ToolError("Add at least one participant.")
    arguments = ["groups", "create", "--name", title]
    for user in users:
        arguments += ["--user", user]
    for flag, enabled in (("--announce-only", announce_only), ("--locked", locked),
                          ("--join-approval", join_approval), ("--community", community)):
        if enabled:
            arguments.append(flag)
    if community_jid:
        arguments += ["--linked-parent", exact_jid(community_jid, "community_jid")]
    data = gateway(arguments, "whatsapp-write", account, timeout=120) or {}
    jid = str((data.get("jid") or data.get("JID") or data.get("id") or "")
              if isinstance(data, dict) else "")
    result: dict[str, Any] = {"done": True, "jid": jid, "name": title}
    if description:
        if jid and indexed_chat(jid, account):
            helper("group-action", {"account": account, "jid": jid, "action": "description",
                                    "value": text_argument(description, "description")},
                   timeout=90)
            result["description_set"] = True
        else:
            result["description_set"] = False
            result["note"] = ("The group exists but is not in the local archive yet; "
                              "set the description with manage_group in a moment.")
    return compact(result)


# A community and the groups inside it are not in the chat rail, so the
# helper's group-action cannot reach them; the same actions then go through
# the guarded wacli gateway with the class each one needs.
OUTSIDE_RAIL = "not available in the local WhatsApp index"


def gateway_group_action(jid: str, action: str, value: Any, account: str) -> dict[str, Any]:
    target = ["--jid", jid]
    users = value if isinstance(value, list) else [value]
    flags: list[str] = []
    for user in users:
        if user:
            flags += ["--user", str(user)]
    table: dict[str, tuple[list[str], str]] = {
        "rename": (["groups", "rename", *target, "--name", str(value or "")], "whatsapp-write"),
        "description": (["groups", "description", *target, "--text", str(value or "")],
                        "whatsapp-write"),
        "announce": (["groups", "announce-only", *target, "--on" if value else "--off"],
                     "whatsapp-write"),
        "locked": (["groups", "locked", *target, "--on" if value else "--off"], "whatsapp-write"),
        "add": (["groups", "participants", "add", *target, *flags], "whatsapp-write"),
        "promote": (["groups", "participants", "promote", *target, *flags], "whatsapp-write"),
        "demote": (["groups", "participants", "demote", *target, *flags], "destructive"),
        "remove": (["groups", "participants", "remove", *target, *flags], "destructive"),
        "invite-get": (["groups", "invite", "link", "get", *target], "remote-read"),
        "invite-revoke": (["groups", "invite", "link", "revoke", *target], "destructive"),
        "requests": (["groups", "requests", "list", *target], "remote-read"),
        "approve": (["groups", "requests", "approve", *target, *flags], "whatsapp-write"),
        "reject": (["groups", "requests", "reject", *target, *flags], "destructive"),
        "leave": (["groups", "leave", *target], "destructive"),
    }
    arguments, token = table[action]
    data = gateway(arguments, token, account, timeout=120)
    return dict(data if isinstance(data, dict) else {"result": data}, outside_rail=True)


def run_group_action(request: dict[str, Any]) -> dict[str, Any]:
    try:
        answer = helper("group-action", request, timeout=120)
    except ToolError as exc:
        if OUTSIDE_RAIL not in str(exc):
            raise
        answer = gateway_group_action(request["jid"], request["action"], request.get("value"),
                                      str(request.get("account") or ""))
    answer.pop("ok", None)
    answer.pop("kind", None)
    return compact(dict(answer, done=True))


GROUP_ACTIONS = ["rename", "description", "announce_only", "locked", "add", "promote",
                 "approve_request", "invite_link", "pending_requests"]


@tool("manage_group", "Manage a group",
      "Rename, describe, add people, promote admins, approve join requests, get the invite "
      "link, list pending requests, or turn admin-only messages and info editing on or off. "
      "Removing people and leaving are in remove_or_leave_group.",
      {"jid": JID, "action": {"type": "string", "enum": GROUP_ACTIONS},
       "value": {"description": "rename/description: text; announce_only/locked: true or false; "
                                "add: list of jids or phone numbers; promote/approve_request: one jid."}},
      ("jid", "action"), kind="write")
def manage_group(jid: str, action: str, value: Any = None, account: str = "") -> dict[str, Any]:
    names = {"announce_only": "announce", "approve_request": "approve",
             "invite_link": "invite-get", "pending_requests": "requests"}
    request: dict[str, Any] = {"account": account, "jid": exact_jid(jid),
                               "action": names.get(action, action)}
    if action in ("rename", "description"):
        request["value"] = text_argument(value, action, action == "rename")
    elif action in ("announce_only", "locked"):
        if not isinstance(value, bool):
            raise ToolError("value must be true or false.")
        request["value"] = value
    elif action == "add":
        request["value"] = group_users(value if isinstance(value, list) else [value])
    elif action in ("promote", "approve_request"):
        request["value"] = exact_jid(value, "value")
    if action in ("invite_link", "pending_requests"):
        request["authorization"] = "remote-read"
    return run_group_action(request)


@tool("remove_or_leave_group", "Remove people or leave a group",
      "Remove a participant, take away admin, reject a join request, reset the invite link, "
      "or leave the group.",
      {"jid": JID, "action": {"type": "string",
                              "enum": ["remove", "demote", "reject_request", "reset_invite_link", "leave"]},
       "user": {"type": "string", "description": "Participant jid for remove, demote and reject_request."}},
      ("jid", "action"), kind="write", destructive=True)
def remove_or_leave_group(jid: str, action: str, user: str = "",
                          account: str = "") -> dict[str, Any]:
    names = {"reject_request": "reject", "reset_invite_link": "invite-revoke"}
    request: dict[str, Any] = {"account": account, "jid": exact_jid(jid),
                               "action": names.get(action, action)}
    if action in ("remove", "demote", "reject_request"):
        request["value"] = exact_jid(user, "user")
    return run_group_action(request)


# ------------------------------------------------------------------ v2

@tool("fetch_older_history", "Fetch older history",
      "Ask the phone for older messages of one chat that are not in the local archive yet. "
      "It is a routine in two calls: the first returns what to ask the user (open WhatsApp "
      "on the phone, on that chat) and changes nothing; call again with phone_ready: true "
      "only after the user confirms. Each batch pauses background sync for up to about a "
      "minute. If the phone does not answer, tell the user; do not retry on your own.",
      {"chat": CHAT,
       "phone_ready": {"type": "boolean",
                       "description": "true only after the user said WhatsApp is open on the phone."},
       "batches": {"type": "integer", "description": "History batches to request, default 1, at most 10."},
       "per_batch": {"type": "integer", "description": "Messages per batch, default 50, at most 200."}},
      ("chat",), kind="write")
def fetch_older_history(chat: str, phone_ready: bool = False, batches: int = 1,
                        per_batch: int = 50, account: str = "") -> dict[str, Any]:
    target = resolve_chat(chat, account)
    scope = str(target.get("account") or account)
    details = helper("chat-details", chat_payload(target, account))
    before = details.get("counts") or {}
    name = str((details.get("chat") or {}).get("name") or target.get("name") or "this chat")
    oldest = local_time(details.get("since"))
    if not phone_ready:
        # Nothing is paused yet: the phone answers history requests only
        # while WhatsApp runs there, so the user opens it first. It must be
        # the phone of the number linked here, not the contact's.
        try:
            linked = gateway(["auth", "status"], account=scope) or {}
        except ToolError:
            linked = {}
        digits = digits_of(linked.get("phone") if isinstance(linked, dict) else "")
        phone = f" with the number +{digits}" if digits else ""
        since = f" This computer has its messages since {oldest[:10]}; if the chat began then, there is nothing older." if oldest else ""
        return compact({
            "done": False,
            "ask_user": (f"Open WhatsApp on the phone{phone} (the account linked here, not "
                         f"{name}'s phone), open the chat with {name}, and keep the screen on. "
                         "Tell me when it is ready." + since),
            "local_archive_starts": oldest,
            "messages_here": before.get("total"),
            "next": "After the user confirms, call fetch_older_history again with phone_ready: true.",
        })
    requests = bounded(batches, 1, 1, 10)
    try:
        gateway(["history", "backfill", "--chat", target["jid"], "--requests", str(requests),
                 "--count", str(bounded(per_batch, 50, 1, 200))], "sync", scope,
                timeout=90 * requests + 30)
    except ToolError as exc:
        detail = str(exc)
        silent = "no history response" in detail or "too long" in detail.lower()
        raise ToolError(
            ("The phone did not answer the history request. " if silent else detail + " ")
            + "Either the chat has nothing older than what this computer has, or WhatsApp was "
            "not open on the phone of the linked number. Ask the user which it is before "
            "trying once more.") from exc
    after = helper("chat-details", chat_payload(target, account)).get("counts") or {}
    fetched = int(after.get("total") or 0) - int(before.get("total") or 0)
    result: dict[str, Any] = {"done": True, "fetched": max(0, fetched),
                              "messages_before": before.get("total"),
                              "messages_now": after.get("total")}
    if fetched <= 0:
        result["note"] = ("The phone sent nothing new: this chat may have no older messages, "
                          "or the phone did not have them loaded.")
    return result


@tool("list_calls", "Call history",
      "Voice and video calls newest first, in every chat or one; missed_only keeps the "
      "incoming calls you did not answer.",
      {"chat": CHAT, "after": DATE, "before": DATE, "missed_only": BOOL,
       "limit": {"type": "integer", "description": "Default 30, at most 200."}})
def list_calls(chat: str = "", after: str = "", before: str = "", missed_only: bool = False,
               limit: int = 30, account: str = "") -> dict[str, Any]:
    count = bounded(limit, 30, 1, 200)
    # Missed calls are a minority, so a filtered request scans the whole window.
    arguments = ["calls", "list", "--limit", str(200 if missed_only else count)]
    if chat:
        arguments += ["--chat", resolve_chat(chat, account)["jid"]]
    if after:
        arguments += ["--after", rfc3339(after, "after")]
    if before:
        arguments += ["--before", rfc3339(before, "before")]
    data = gateway(arguments, account=account) or {}
    rows = (data.get("calls") or []) if isinstance(data, dict) else []
    calls = []
    for row in rows:
        incoming = row.get("direction") == "inbound"
        if missed_only and not (incoming and row.get("outcome") in ("missed", "rejected")):
            continue
        calls.append(compact({
            "chat_jid": row.get("chat_jid"), "name": row.get("chat_name") or row.get("sender_name"),
            "time": local_time(row.get("timestamp")),
            "direction": "incoming" if incoming else "outgoing",
            "outcome": row.get("outcome"), "media": row.get("media"),
            "group_call": True if row.get("call_type") not in (None, "", "regular") else None,
        }))
    return {"calls": calls[:count]}


@tool("list_contact_tags", "Contact tags",
      "The tags you gave your contacts and how many people carry each.", {})
def list_contact_tags(account: str = "") -> dict[str, Any]:
    return {"tags": helper("contact-tags", {"account": account}).get("tags") or []}


@tool("tag_contacts", "Tag contacts",
      "Add a tag to people, or remove it (for example fornecedores, clientes). Tags live in "
      "this computer's archive, not on the phone. Pauses background sync briefly.",
      {"jids": {"type": "array", "items": {"type": "string"}, "description": "Exact contact jids, up to 50."},
       "tag": STRING, "remove": BOOL}, ("jids", "tag"), kind="write")
def tag_contacts(jids: list[str], tag: str, remove: bool = False,
                 account: str = "") -> dict[str, Any]:
    label = " ".join(str(tag or "").split())
    if not 1 <= len(label) <= 64:
        raise ToolError("A tag needs 1 to 64 characters.")
    if not 1 <= len(jids) <= MAX_BULK:
        raise ToolError(f"Choose 1 to {MAX_BULK} people.")
    done: list[str] = []
    for jid in jids:
        try:
            gateway(["contacts", "tags", "rm" if remove else "add", "--jid", exact_jid(jid),
                     "--tag", label], "local-write", account, timeout=60)
        except ToolError as exc:
            raise ToolError(f"Stopped at {jid}: {exc}. Already done: "
                            + (", ".join(done) or "none")) from exc
        done.append(jid)
    return {"done": True, "tag": label, "people": len(done), "removed": remove}


@tool("set_contact_alias", "Set a contact alias",
      "Give a person your own name for them on this computer, or clear it with an empty alias.",
      {"jid": {"type": "string", "description": "Exact contact jid."}, "alias": STRING},
      ("jid",), kind="write")
def set_contact_alias(jid: str, alias: str = "", account: str = "") -> dict[str, Any]:
    name = " ".join(str(alias or "").split())[:128]
    arguments = (["contacts", "alias", "set", "--jid", exact_jid(jid), "--alias", name] if name
                 else ["contacts", "alias", "rm", "--jid", exact_jid(jid)])
    gateway(arguments, "local-write", account, timeout=60)
    return {"done": True, "alias": name}


def person_name(jid: str, account: str, chats: list[dict[str, Any]]) -> str:
    for row in chats:
        if row.get("jid") == jid and row.get("name"):
            return str(row["name"])
    people = helper("contacts-search", {"account": account,
                                        "query": jid.split("@")[0], "limit": 5}).get("people") or []
    for person in people:
        if person.get("jid") == jid:
            return str(person.get("alias") or person.get("name") or "")
    return ""


@tool("send_individually", "Send one message to each person",
      "Send the same text to each person as a separate private message (not a group), for "
      "example everyone with a tag from find_contacts. {name} in the text becomes each "
      "person's first name. Sends one at a time with a pause and stops at the first failure.",
      {"jids": {"type": "array", "items": {"type": "string"},
                "description": "Exact person jids, up to 50. Show the list to the user first."},
       "text": STRING,
       "pause_seconds": {"type": "integer", "description": "Wait between messages, default 4, 2 to 60."}},
      ("jids", "text"), kind="write")
def send_individually(jids: list[str], text: str, pause_seconds: int = 4,
                      account: str = "") -> dict[str, Any]:
    template = text_argument(text, "text")
    people = list(dict.fromkeys(exact_jid(jid) for jid in jids))
    if not 1 <= len(people) <= MAX_BULK:
        raise ToolError(f"Choose 1 to {MAX_BULK} people.")
    if any(not jid.endswith(("@s.whatsapp.net", "@lid")) for jid in people):
        raise ToolError("send_individually is for people; use send_message for a group.")
    pause = bounded(pause_seconds, 4, 2, 60)
    chats = all_chats(account)
    known = {row.get("jid") for row in chats}
    sent_to: list[str] = []
    for index, jid in enumerate(people):
        first = (person_name(jid, account, chats).split() or [""])[0]
        message = template.replace("{name}", first).strip()
        try:
            if jid in known:
                helper("send", {"account": account, "jid": jid, "text": message}, timeout=120)
            else:
                helper("send-new", {"account": account, "target": {"jid": jid},
                                    "text": message}, timeout=120)
        except ToolError as exc:
            return compact({"done": False, "sent": len(sent_to), "sent_to": sent_to,
                            "stopped_at": jid, "error": str(exc),
                            "not_sent": people[index + 1:]})
        sent_to.append(jid)
        if index < len(people) - 1:
            time.sleep(pause)
    return {"done": True, "sent": len(sent_to)}


