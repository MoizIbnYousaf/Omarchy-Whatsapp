#!/usr/bin/env python3
"""WhatsApp for Omarchy for AI agents: a Model Context Protocol server over stdio.

Every tool calls the installed ``omawhatsapp`` helper, which owns the local
mirror, the guarded wacli gateway and its authorization classes. This server
only names the operations and shapes their answers for a model; it never
opens the WhatsApp store itself.

Reads stay on this computer. Every tool that changes WhatsApp says so in its
annotations, so an MCP host such as Claude Code asks before each call. A write
is never retried here: a request that timed out may still have been delivered.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any, Callable

VERSION = "1.0.0"
PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")
HELPER = Path(os.environ.get("OMAW_HELPER")
              or Path(__file__).resolve().with_name("omawhatsapp"))
MAX_TEXT = 4096
MAX_BULK = 50
PHONE = re.compile(r"^\+?[0-9][0-9 ()\-.]{6,24}$")
INVITE = re.compile(r"(?:chat\.whatsapp\.com/(?:invite/)?)?([A-Za-z0-9]{16,32})$")

INSTRUCTIONS = """\
WhatsApp for Omarchy reads the user's local WhatsApp mirror and acts on WhatsApp for them.
- Resolve a chat before acting: list_chats, find_contacts or search results
  give the exact jid. Never guess one. When several chats match a name, ask.
- Tools that send, change or delete something on WhatsApp are marked as not
  read-only; the host asks the user first. Show the exact text and recipient
  when you propose one, and never retry a failed send on your own.
- Times are ISO 8601 in the user's local time zone. Dates you pass may be
  YYYY-MM-DD or ISO 8601.
- Reading never marks a chat read. Only set_chat_state does, when asked.
- A few actions pause background sync for seconds (group creation, contact
  tags, profile, status, channels, older history). A message arriving then is
  missing from the local mirror until wacli catches up, though the phone has it.
- Message text and attachments are private. Do not copy them anywhere the
  user did not ask for.
"""


class ToolError(Exception):
    def __init__(self, message: str, partial: Any = None) -> None:
        super().__init__(message)
        self.partial = partial


# ------------------------------------------------------------------ helper

def helper(command: str, payload: dict[str, Any] | None = None, *args: str,
           timeout: float = 60) -> dict[str, Any]:
    """Run one helper command with a JSON request and return its answer."""
    stdin = None if payload is None else json.dumps(payload, ensure_ascii=False) + "\n"
    try:
        result = subprocess.run(
            [sys.executable, str(HELPER), command, *args], input=stdin,
            capture_output=True, text=True, timeout=timeout, check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise ToolError(f"WhatsApp for Omarchy did not answer within {int(timeout)} seconds. "
                        "If this was a send, check the chat before trying again.") from exc
    except OSError as exc:
        raise ToolError("The WhatsApp for Omarchy helper is not installed.") from exc
    try:
        value = json.loads(result.stdout or "{}")
    except ValueError as exc:
        raise ToolError("WhatsApp for Omarchy returned an unreadable answer.") from exc
    if not isinstance(value, dict) or value.get("ok") is not True:
        message = value.get("error") if isinstance(value, dict) else ""
        partial = value.get("partial") if isinstance(value, dict) else None
        raise ToolError(str(message or "WhatsApp for Omarchy could not complete that request."), partial)
    return value


def gateway(arguments: list[str], authorization: str = "", account: str = "",
            timeout: int = 120, **extra: Any) -> Any:
    """One guarded wacli operation; the helper checks the class token."""
    payload = {"args": arguments, "authorization": authorization,
               "account": account, "timeout": timeout, **extra}
    return helper("wacli", payload, timeout=timeout + 30).get("data")


# ------------------------------------------------------------------ values

def local_time(value: Any) -> str:
    """Epoch seconds or milliseconds, or an RFC 3339 string, in local time."""
    if value in (None, "", 0):
        return ""
    if isinstance(value, str) and not value.isdigit():
        try:
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return value
        return parsed.astimezone().isoformat(timespec="minutes")
    try:
        number = int(value)
    except (TypeError, ValueError):
        return ""
    if number > 10**12:
        number //= 1000
    return datetime.fromtimestamp(number).astimezone().isoformat(timespec="minutes")


def epoch(value: Any, name: str) -> int | None:
    """A date the model passed, as epoch seconds; YYYY-MM-DD is local midnight."""
    if value in (None, ""):
        return None
    if isinstance(value, (int, float)):
        return int(value)
    text = str(value).strip()
    try:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
            return int(datetime.strptime(text, "%Y-%m-%d").timestamp())
        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.astimezone()
        return int(parsed.timestamp())
    except ValueError as exc:
        raise ToolError(f"{name} must be YYYY-MM-DD or an ISO 8601 date and time.") from exc


def rfc3339(value: Any, name: str) -> str:
    moment = epoch(value, name)
    return "" if moment is None else datetime.fromtimestamp(moment).astimezone().isoformat()


def compact(value: Any) -> Any:
    """Drop empty fields so answers stay short; False and 0 carry meaning."""
    if isinstance(value, dict):
        return {key: compact(item) for key, item in value.items()
                if item not in (None, "", [], {})}
    if isinstance(value, list):
        return [compact(item) for item in value]
    return value


def digits_of(value: Any) -> str:
    return re.sub(r"\D", "", str(value or ""))


def text_argument(value: Any, name: str, required: bool = True) -> str:
    text = str(value or "").strip()
    if required and not text:
        raise ToolError(f"{name} cannot be empty.")
    if len(text) > MAX_TEXT:
        raise ToolError(f"{name} is too long (maximum {MAX_TEXT} characters).")
    return text


# ------------------------------------------------------------------ shapes

def shape_chat(row: dict[str, Any]) -> dict[str, Any]:
    return compact({
        "jid": row.get("jid"), "account": row.get("account"), "name": row.get("name"),
        "kind": row.get("kind"), "unread": int(row.get("unread") or 0),
        "pinned": bool(row.get("pinned")), "muted": bool(row.get("muted")),
        "archived": bool(row.get("archived")),
        "last": compact({
            "time": local_time(row.get("timestamp")),
            "from_me": bool(row.get("last_from_me")),
            "sender": row.get("last_sender"),
            "preview": row.get("preview"),
            "media_type": row.get("last_media_type"),
        }),
    })


def shape_message(row: dict[str, Any]) -> dict[str, Any]:
    from_me = bool(row.get("from_me"))
    shaped: dict[str, Any] = {
        "id": row.get("id"), "time": local_time(row.get("timestamp")), "from_me": from_me,
        "sender": "You" if from_me else row.get("sender"),
        "sender_jid": None if from_me else row.get("sender_jid"),
        "text": row.get("text"), "media_type": row.get("media_type"),
        "filename": row.get("filename"), "mime_type": row.get("mime_type"),
        "on_disk": bool(row.get("local_path")) if row.get("media_type") else None,
        "edited": True if row.get("edited") else None,
        "forwarded": True if row.get("forwarded") else None,
        "starred": True if row.get("starred") else None,
        "deleted_for_everyone": True if row.get("revoked") else None,
        # sent, delivered, read or played; absent when wacli recorded none.
        "delivery": row.get("status") if from_me and row.get("status") else None,
    }
    cards = row.get("contacts")
    if isinstance(cards, list) and cards:
        shaped["shared_contacts"] = [compact({"name": card.get("name"), "phone": card.get("phone"),
                                              "jid": card.get("jid"),
                                              "has_chat": True if card.get("has_chat") else None})
                                     for card in cards if isinstance(card, dict)]
    poll = row.get("poll")
    if isinstance(poll, dict):
        shaped["poll"] = compact({
            "question": poll.get("question"), "choices_allowed": poll.get("selectable"),
            "voters": poll.get("voters"),
            "options": [compact({"text": option.get("text"), "votes": option.get("votes"),
                                 "voters": option.get("voters"),
                                 "mine": True if option.get("mine") else None})
                        for option in poll.get("options") or [] if isinstance(option, dict)],
        })
    if row.get("quoted_id"):
        shaped["reply_to"] = compact({
            "id": row.get("quoted_id"), "sender": row.get("quoted_sender"),
            "text": str(row.get("quoted_text") or "")[:280],
            "media_type": row.get("quoted_media_type"),
        })
    reactions = row.get("reactions")
    if isinstance(reactions, list) and reactions:
        shaped["reactions"] = [compact({"emoji": item.get("emoji"),
                                        "from_me": bool(item.get("from_me")) or None,
                                        "sender": item.get("sender")})
                               for item in reactions if isinstance(item, dict)]
    if row.get("latitude") is not None:
        shaped["location"] = compact({
            "latitude": row.get("latitude"), "longitude": row.get("longitude"),
            "name": row.get("location_name"), "address": row.get("location_address"),
        })
    return compact(shaped)


def shape_found(row: dict[str, Any]) -> dict[str, Any]:
    """A message row from wacli's own JSON (search, starred, list, context)."""
    from_me = bool(row.get("FromMe"))
    return compact({
        "chat_jid": row.get("ChatJID"), "chat_name": row.get("ChatName"),
        "id": row.get("MsgID"), "time": local_time(row.get("Timestamp")),
        "from_me": from_me, "sender": "You" if from_me else row.get("SenderName"),
        "sender_jid": None if from_me else row.get("SenderJID"),
        "text": row.get("Text") or row.get("DisplayText"),
        "match": row.get("Snippet"), "media_type": row.get("MediaType"),
        "filename": row.get("Filename"), "caption": row.get("MediaCaption"),
        "starred": True if row.get("Starred") else None,
        "forwarded": True if row.get("IsForwarded") else None,
    })


def shape_attachment(row: dict[str, Any]) -> dict[str, Any]:
    return compact({
        "chat_jid": row.get("chat_jid"), "chat_name": row.get("chat_name"),
        "id": row.get("id"), "time": local_time(row.get("timestamp")),
        "from_me": bool(row.get("from_me")),
        "sender": "You" if row.get("from_me") else row.get("sender"),
        "sender_jid": None if row.get("from_me") else row.get("sender_jid"),
        "media_type": row.get("media_type"), "filename": row.get("filename"),
        "mime_type": row.get("mime_type"), "caption": row.get("caption"),
        "size_bytes": row.get("file_size") or None,
        "local_path": row.get("local_path"),
        "expired": True if row.get("available") is False else None,
        "location": compact({"latitude": row.get("latitude"), "longitude": row.get("longitude"),
                             "name": row.get("location_name"),
                             "address": row.get("location_address")})
        if row.get("latitude") is not None else None,
    })


# ------------------------------------------------------------------ chats

def all_chats(account: str = "") -> list[dict[str, Any]]:
    return helper("chats", {"account": account}, "--limit", "500").get("chats") or []


def resolve_chat(value: Any, account: str = "") -> dict[str, Any]:
    """A jid, a phone number or a chat name, to one exact rail chat."""
    text = str(value or "").strip()
    if not text:
        raise ToolError("Name the chat: a jid from list_chats, a phone number or a chat name.")
    if "@" in text:
        return {"jid": text, "account": account, "name": ""}
    rows = all_chats(account)
    if PHONE.match(text):
        digits = digits_of(text)
        matches = [row for row in rows if digits_of(str(row.get("jid", "")).split("@")[0])
                   .endswith(digits[-10:])]
    else:
        needle = text.casefold()
        exact = [row for row in rows if str(row.get("name") or "").casefold() == needle]
        matches = exact or [row for row in rows if needle in str(row.get("name") or "").casefold()]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise ToolError(f'No chat matches "{text}". Try find_contacts, or start_chat for a '
                        "number you have never messaged.")
    options = [compact({"jid": row.get("jid"), "name": row.get("name"), "kind": row.get("kind"),
                        "account": row.get("account"), "last": local_time(row.get("timestamp"))})
               for row in matches[:12]]
    raise ToolError("Several chats match. Ask the user which one, then pass its jid: "
                    + json.dumps(options, ensure_ascii=False))


def chat_payload(chat: dict[str, Any], account: str, **fields: Any) -> dict[str, Any]:
    return {"account": str(chat.get("account") or account or ""), "jid": chat["jid"], **fields}


def exact_jid(value: Any, name: str = "jid") -> str:
    text = str(value or "").strip()
    if "@" not in text or len(text) > 160:
        raise ToolError(f"{name} must be an exact jid from list_chats, find_contacts or a "
                        "search result.")
    return text


def chat_pages(chat: dict[str, Any], account: str, *, limit: int, before: Any = None,
               after: int | None = None, query: str = "", kind: str = "",
               ) -> tuple[list[dict[str, Any]], bool]:
    """Messages newest first, paging back until ``after`` or ``limit``."""
    collected: list[dict[str, Any]] = []
    cursor = before
    more = True
    while more and len(collected) < limit:
        page = min(300, limit - len(collected) + 1)
        fields: dict[str, Any] = {"query": query, "kind": kind}
        if cursor:
            fields["before"] = cursor
        answer = helper("messages", chat_payload(chat, account, **fields), "--limit", str(page))
        rows = answer.get("messages") or []
        more = bool(answer.get("has_more"))
        for row in rows:
            if after is not None and int(row.get("timestamp") or 0) <= after:
                return collected, False
            collected.append(row)
            if len(collected) >= limit:
                return collected, True
        if not rows:
            break
        cursor = {"ts": rows[-1].get("timestamp"), "id": rows[-1].get("id")}
    return collected, more


def cursor_of(value: Any) -> dict[str, Any] | None:
    """``before`` is a date, or the ``next_before`` token of an earlier page."""
    if value in (None, ""):
        return None
    text = str(value)
    if text.startswith("cursor:"):
        _, ts, identifier = (text.split(":", 2) + ["", ""])[:3]
        return {"ts": int(ts or 0), "id": identifier}
    return {"ts": epoch(value, "before"), "id": ""}


# ------------------------------------------------------------------ tools

TOOLS: dict[str, dict[str, Any]] = {}
ACCOUNT = {"type": "string", "description": "Named wacli account; leave empty for the default."}


def tool(name: str, title: str, description: str, properties: dict[str, Any],
         required: tuple[str, ...] = (), *, kind: str = "read",
         destructive: bool = False) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
    """Register a tool. ``kind`` is read (local), remote (asks WhatsApp) or write."""
    def register(function: Callable[..., Any]) -> Callable[..., Any]:
        TOOLS[name] = {
            "name": name, "title": title, "description": description,
            "inputSchema": {"type": "object",
                            "properties": {**properties, "account": ACCOUNT},
                            "required": list(required), "additionalProperties": False},
            "annotations": {"title": title, "readOnlyHint": kind != "write",
                            "destructiveHint": destructive,
                            "idempotentHint": kind != "write",
                            "openWorldHint": kind != "read"},
            "handler": function,
        }
        return function
    return register


def validate(schema: dict[str, Any], arguments: Any) -> dict[str, Any]:
    if arguments is None:
        arguments = {}
    if not isinstance(arguments, dict):
        raise ToolError("Arguments must be an object.")
    properties = schema["properties"]
    unknown = sorted(set(arguments) - set(properties))
    if unknown:
        raise ToolError("Unknown argument: " + ", ".join(unknown))
    for key in schema["required"]:
        if arguments.get(key) in (None, "", []):
            raise ToolError(f"{key} is required.")
    checks = {"string": str, "boolean": bool, "array": list, "object": dict}
    for key, value in arguments.items():
        if value is None:
            continue
        expected = properties[key].get("type")
        if expected == "integer":
            if isinstance(value, bool) or not isinstance(value, int):
                raise ToolError(f"{key} must be a whole number.")
        elif expected == "number":
            if isinstance(value, bool) or not isinstance(value, (int, float)):
                raise ToolError(f"{key} must be a number.")
        elif expected in checks and not isinstance(value, checks[expected]):
            raise ToolError(f"{key} must be a {expected}.")
        allowed = properties[key].get("enum")
        if allowed and value not in allowed:
            raise ToolError(f"{key} must be one of: " + ", ".join(map(str, allowed)))
        if expected == "array" and properties[key].get("items", {}).get("type") == "string":
            if not all(isinstance(item, str) for item in value):
                raise ToolError(f"{key} must be a list of strings.")
    return arguments


def bounded(value: Any, fallback: int, low: int, high: int) -> int:
    try:
        number = int(value)
    except (TypeError, ValueError):
        return fallback
    return max(low, min(number, high))


STRING = {"type": "string"}
BOOL = {"type": "boolean"}
DATE = {"type": "string", "description": "YYYY-MM-DD or ISO 8601, local time."}
CHAT = {"type": "string", "description": "Chat jid, phone number or chat name."}
JID = {"type": "string", "description": "Exact jid of an existing chat (from list_chats, find_contacts or a search result)."}
MESSAGE = {"type": "string", "description": "Message id from read_chat or a search result."}
STRINGS = {"type": "array", "items": {"type": "string"}}


# ------------------------------------------------------------------ v1 reads

@tool("whatsapp_status", "WhatsApp status",
      "Whether WhatsApp is linked and syncing, the linked accounts, and how many chats "
      "are unread. Call it first when something fails.", {})
def whatsapp_status(account: str = "") -> dict[str, Any]:
    status = helper("status", None, "--account", account)
    chats = all_chats(account) if status.get("rail_ready") else []
    return compact({
        "authenticated": bool(status.get("authenticated")),
        "local_archive_ready": bool(status.get("database_ready")),
        "syncing": bool(status.get("sync_active")),
        "offline_mode": bool(status.get("offline_mode")),
        "accounts": [compact({"name": item.get("name"), "label": item.get("label"),
                              "authenticated": bool(item.get("authenticated"))})
                     for item in status.get("accounts") or [] if isinstance(item, dict)],
        "unread_chats": sum(1 for chat in chats if int(chat.get("unread") or 0) > 0),
        "chats": len(chats),
    })


VIEWS = ["all", "unread", "people", "groups", "pinned", "muted", "archived"]


@tool("list_chats", "List chats",
      "Chats newest first with unread counts and the last message. Filter by name or "
      "by view. Use it to find the exact jid before reading or acting on a chat.",
      {"query": {"type": "string", "description": "Part of the chat name, or a phone number."},
       "view": {"type": "string", "enum": VIEWS, "description": "Default all (archived chats are left out unless view is archived)."},
       "limit": {"type": "integer", "description": "Default 30, at most 200."}})
def list_chats(query: str = "", view: str = "all", limit: int = 30,
               account: str = "") -> dict[str, Any]:
    rows = all_chats(account)
    if query:
        if PHONE.match(query):
            digits = digits_of(query)[-10:]
            rows = [row for row in rows if digits in str(row.get("jid", ""))]
        else:
            needle = query.casefold()
            rows = [row for row in rows if needle in str(row.get("name") or "").casefold()]
    tests = {
        "unread": lambda row: int(row.get("unread") or 0) > 0,
        "people": lambda row: row.get("kind") == "dm",
        "groups": lambda row: row.get("kind") == "group",
        "pinned": lambda row: bool(row.get("pinned")),
        "muted": lambda row: bool(row.get("muted")),
    }
    if view == "archived":
        rows = [row for row in rows if row.get("archived")]
    else:
        rows = [row for row in rows if not row.get("archived")]
        if view in tests:
            rows = [row for row in rows if tests[view](row)]
    count = bounded(limit, 30, 1, 200)
    return {"chats": [shape_chat(row) for row in rows[:count]],
            "more": max(0, len(rows) - count)}


def unread_split(rows: list[dict[str, Any]], unread: int) -> list[dict[str, Any]]:
    """Newest-first rows to oldest-first, flagging the newest incoming ``unread``."""
    left = unread
    flagged: list[dict[str, Any]] = []
    for row in rows:
        shaped = shape_message(row)
        if left > 0 and not row.get("from_me"):
            shaped["unread"] = True
            left -= 1
        flagged.append(shaped)
    return list(reversed(flagged))


@tool("unread_messages", "Unread messages",
      "Every chat with unread messages and those messages, with a few earlier ones for "
      "context (flagged unread: true on the unread ones). Muted and archived chats are "
      "counted but left out unless asked. Use it for 'who wrote to me and what about'.",
      {"max_chats": {"type": "integer", "description": "Default 15, at most 40."},
       "per_chat": {"type": "integer", "description": "Unread messages per chat, default 20, at most 80."},
       "context": {"type": "integer", "description": "Earlier messages per chat, default 4, at most 20."},
       "include_muted": BOOL, "include_archived": BOOL})
def unread_messages(max_chats: int = 15, per_chat: int = 20, context: int = 4,
                    include_muted: bool = False, include_archived: bool = False,
                    account: str = "") -> dict[str, Any]:
    rows = [row for row in all_chats(account) if int(row.get("unread") or 0) > 0]
    skipped = [row for row in rows
               if (row.get("muted") and not include_muted)
               or (row.get("archived") and not include_archived)]
    chosen = [row for row in rows if row not in skipped]
    limit = bounded(max_chats, 15, 1, 40)
    each = bounded(per_chat, 20, 1, 80)
    earlier = bounded(context, 4, 0, 20)
    out = []
    for row in chosen[:limit]:
        unread = int(row.get("unread") or 0)
        shown = min(unread, each)
        messages, _ = chat_pages(row, account, limit=shown + earlier)
        out.append(compact({
            "chat": shape_chat(row), "unread": unread,
            "not_shown": unread - shown if unread > shown else None,
            "messages": unread_split(messages, shown),
        }))
    return compact({
        "chats": out,
        "more_unread_chats": max(0, len(chosen) - limit) or None,
        "left_out": compact({
            "muted": sum(1 for row in skipped if row.get("muted")),
            "archived": sum(1 for row in skipped if row.get("archived")),
        }) or None,
    })


@tool("awaiting_reply", "Chats awaiting your reply",
      "Chats where the last message is from the other person and you have not answered: "
      "a to-do list of replies. Groups are left out unless include_groups is true.",
      {"min_hours": {"type": "integer", "description": "Only chats waiting at least this long. Default 0."},
       "max_days": {"type": "integer", "description": "Ignore chats quiet for longer. Default 14."},
       "include_groups": BOOL,
       "limit": {"type": "integer", "description": "Default 25, at most 100."}})
def awaiting_reply(min_hours: int = 0, max_days: int = 14, include_groups: bool = False,
                   limit: int = 25, account: str = "") -> dict[str, Any]:
    now = time.time()
    newest = now - bounded(min_hours, 0, 0, 24 * 90) * 3600
    oldest = now - bounded(max_days, 14, 1, 365) * 86400
    waiting = []
    for row in all_chats(account):
        stamp = int(row.get("timestamp") or 0)
        if row.get("last_from_me") or row.get("archived") or not stamp:
            continue
        if row.get("kind") != "dm" and not (include_groups and row.get("kind") == "group"):
            continue
        if oldest <= stamp <= newest:
            shaped = shape_chat(row)
            shaped["waiting_hours"] = round((now - stamp) / 3600, 1)
            waiting.append(shaped)
    count = bounded(limit, 25, 1, 100)
    return {"chats": waiting[:count], "more": max(0, len(waiting) - count)}


@tool("read_chat", "Read a chat",
      "Messages of one chat, oldest first. Pages back from 'before' (default now) until "
      "'after' or 'limit'. Pass next_before from the answer to read further back.",
      {"chat": CHAT, "limit": {"type": "integer", "description": "Default 50, at most 500."},
       "before": {"type": "string", "description": "YYYY-MM-DD, ISO 8601 or a next_before token."},
       "after": DATE,
       "query": {"type": "string", "description": "Only messages containing this text."}},
      ("chat",))
def read_chat(chat: str, limit: int = 50, before: str = "", after: str = "",
              query: str = "", account: str = "") -> dict[str, Any]:
    target = resolve_chat(chat, account)
    rows, more = chat_pages(target, account, limit=bounded(limit, 50, 1, 500),
                            before=cursor_of(before), after=epoch(after, "after"),
                            query=text_argument(query, "query", False))
    answer: dict[str, Any] = {
        "chat": compact({"jid": target.get("jid"), "name": target.get("name"),
                         "kind": target.get("kind")}),
        "messages": [shape_message(row) for row in reversed(rows)],
        "older_messages": more,
    }
    if more and rows:
        answer["next_before"] = f"cursor:{rows[-1].get('timestamp')}:{rows[-1].get('id')}"
    return answer


MESSAGE_TYPES = ["text", "image", "video", "audio", "document"]


@tool("search_messages", "Search messages",
      "Full-text search over every chat, or inside one chat. Try several keywords and "
      "synonyms when the first search finds nothing (for example filme, série, assiste). "
      "Each result carries chat_jid and id for message_context.",
      {"query": {"type": "string"}, "chat": CHAT,
       "sender": {"type": "string", "description": "Exact sender jid from find_contacts."},
       "after": DATE, "before": DATE,
       "type": {"type": "string", "enum": MESSAGE_TYPES},
       "from_me": {"type": "boolean", "description": "true: only yours; false: only received."},
       "forwarded": BOOL, "starred": BOOL,
       "limit": {"type": "integer", "description": "Default 30, at most 100."}},
      ("query",))
def search_messages(query: str, chat: str = "", sender: str = "", after: str = "",
                    before: str = "", type: str = "", from_me: bool | None = None,
                    forwarded: bool = False, starred: bool = False, limit: int = 30,
                    account: str = "") -> dict[str, Any]:
    needle = text_argument(query, "query")
    count = bounded(limit, 30, 1, 100)
    low, high = epoch(after, "after"), epoch(before, "before")
    if chat:
        # Inside one chat the helper also reads the rows wacli filed under the
        # contact's hidden @lid, which a jid-scoped wacli search would miss.
        target = resolve_chat(chat, account)
        rows, _ = chat_pages(target, account, limit=500, query=needle,
                             before={"ts": high, "id": ""} if high else None, after=low)
        results = []
        for row in rows:
            if from_me is not None and bool(row.get("from_me")) != from_me:
                continue
            if sender and row.get("sender_jid") != sender:
                continue
            if type and (row.get("media_type") or "text") != type:
                continue
            if forwarded and not row.get("forwarded"):
                continue
            if starred and not row.get("starred"):
                continue
            shaped = shape_message(row)
            shaped["chat_jid"] = target.get("jid")
            results.append(shaped)
            if len(results) >= count:
                break
        return {"results": results}
    arguments = ["messages", "search", needle, "--limit", str(min(100, count * 2))]
    if sender:
        arguments += ["--from", exact_jid(sender, "sender")]
    if after:
        arguments += ["--after", rfc3339(after, "after")]
    if before:
        arguments += ["--before", rfc3339(before, "before")]
    if type:
        arguments += ["--type", type]
    if forwarded:
        arguments.append("--forwarded")
    if starred:
        arguments.append("--starred")
    data = gateway(arguments, account=account) or {}
    rows = (data.get("messages") or []) if isinstance(data, dict) else []
    results = [shape_found(row) for row in rows
               if from_me is None or bool(row.get("FromMe")) == from_me]
    return {"results": results[:count]}


@tool("message_context", "Message in context",
      "The messages around one message, to understand a search result.",
      {"chat_jid": {"type": "string", "description": "chat_jid of the search result."},
       "id": MESSAGE,
       "before": {"type": "integer", "description": "Messages before it, default 6."},
       "after": {"type": "integer", "description": "Messages after it, default 6."}},
      ("chat_jid", "id"))
def message_context(chat_jid: str, id: str, before: int = 6, after: int = 6,
                    account: str = "") -> dict[str, Any]:
    data = gateway(["messages", "context", "--chat", exact_jid(chat_jid, "chat_jid"),
                    "--id", str(id), "--before", str(bounded(before, 6, 0, 50)),
                    "--after", str(bounded(after, 6, 0, 50))], account=account)
    rows = data.get("messages") if isinstance(data, dict) else data
    return {"messages": [dict(shape_found(row), match=True if row.get("MsgID") == id else None)
                         for row in rows or [] if isinstance(row, dict)]}


@tool("starred_messages", "Starred messages",
      "Messages starred on WhatsApp, newest first, in every chat or one.",
      {"chat": CHAT, "limit": {"type": "integer", "description": "Default 30, at most 200."}})
def starred_messages(chat: str = "", limit: int = 30, account: str = "") -> dict[str, Any]:
    arguments = ["messages", "starred", "--limit", str(bounded(limit, 30, 1, 200))]
    if chat:
        arguments += ["--chat", resolve_chat(chat, account)["jid"]]
    data = gateway(arguments, account=account) or {}
    rows = (data.get("messages") or []) if isinstance(data, dict) else []
    return {"messages": [shape_found(row) for row in rows]}


ATTACHMENT_KINDS = ["image", "video", "audio", "document", "sticker", "location"]


@tool("list_attachments", "List attachments",
      "Photos, videos, audio, documents, stickers and locations, newest first, from one "
      "chat or every chat, optionally only from one person or a period. local_path is set "
      "when the file is already on this computer; open_attachment fetches it otherwise.",
      {"chat": CHAT, "sender": {"type": "string", "description": "Exact sender jid (find_contacts)."},
       "kinds": {"type": "array", "items": {"type": "string", "enum": ATTACHMENT_KINDS}},
       "direction": {"type": "string", "enum": ["any", "received", "sent"]},
       "after": DATE, "before": DATE,
       "missing_only": {"type": "boolean", "description": "Only the ones not downloaded yet."},
       "limit": {"type": "integer", "description": "Default 40, at most 200."}})
def list_attachments(chat: str = "", sender: str = "", kinds: list[str] | None = None,
                     direction: str = "any", after: str = "", before: str = "",
                     missing_only: bool = False, limit: int = 40,
                     account: str = "") -> dict[str, Any]:
    payload: dict[str, Any] = {
        "account": account, "sender": sender, "kinds": kinds or [], "direction": direction,
        "after": epoch(after, "after"), "before": epoch(before, "before"),
        "missing_only": missing_only, "limit": bounded(limit, 40, 1, 200),
    }
    if chat:
        target = resolve_chat(chat, account)
        payload.update(jid=target["jid"], account=str(target.get("account") or account))
    rows = helper("attachments", payload).get("attachments") or []
    return {"attachments": [shape_attachment(row) for row in rows]}


@tool("open_attachment", "Open an attachment",
      "Puts one attachment on this computer (downloading it from WhatsApp beside the live "
      "sync if needed) and returns its local path. Read that file to see a photo or PDF.",
      {"chat_jid": {"type": "string", "description": "chat_jid from list_attachments, or the chat's jid."},
       "id": MESSAGE}, ("chat_jid", "id"), kind="remote")
def open_attachment(chat_jid: str, id: str, account: str = "") -> dict[str, Any]:
    answer = helper("media", {"account": account, "jid": exact_jid(chat_jid, "chat_jid"),
                              "id": str(id)}, timeout=240)
    path = str(answer.get("local_path") or "")
    return compact({"local_path": path,
                    "size_bytes": Path(path).stat().st_size if path and Path(path).is_file() else None})


@tool("find_contacts", "Find contacts",
      "People this WhatsApp account knows, by name, phone number or contact tag, with "
      "whether a chat already exists, the alias you gave them and their tags.",
      {"query": {"type": "string"}, "tag": {"type": "string"},
       "limit": {"type": "integer", "description": "Default 20, at most 80."}})
def find_contacts(query: str = "", tag: str = "", limit: int = 20,
                  account: str = "") -> dict[str, Any]:
    answer = helper("contacts-search", {"account": account, "query": query, "tag": tag,
                                        "limit": bounded(limit, 20, 1, 80)})
    return {"people": [compact(person) for person in answer.get("people") or []]}


@tool("chat_info", "Chat details",
      "Details of one chat from the local archive: for a group its participants and "
      "roles, your role and the history counts; for a person their numbers and the "
      "groups you share. live: true also asks WhatsApp for the group's settings.",
      {"chat": CHAT, "live": BOOL}, ("chat",))
def chat_info(chat: str, live: bool = False, account: str = "") -> dict[str, Any]:
    target = resolve_chat(chat, account)
    details = helper("chat-details", chat_payload(target, account))
    details.pop("ok", None)
    details.pop("kind", None)  # The answer's own kind; the chat's is details.chat.kind.
    details.pop("avatar_path", None)
    for person in details.get("participants") or []:
        if isinstance(person, dict):
            person.pop("avatar_path", None)
    if "since" in details:
        details["since"] = local_time(details["since"])
    if live and (details.get("chat") or {}).get("kind") == "group":
        settings = helper("group-info", chat_payload(target, account, authorization="remote-read"),
                          timeout=90)
        settings.pop("ok", None)
        details["live_settings"] = settings
    return compact(details)


# ------------------------------------------------------------------ v1 writes

def sent(answer: dict[str, Any], **extra: Any) -> dict[str, Any]:
    return compact({"done": True, "message_id": answer.get("message_id"), **extra})


@tool("send_message", "Send a message",
      "Send a text to one existing chat, optionally as a reply to one of its messages. "
      "mentions lists participant jids for @mentions in groups.",
      {"jid": JID, "text": STRING, "reply_to": MESSAGE, "mentions": STRINGS},
      ("jid", "text"), kind="write")
def send_message(jid: str, text: str, reply_to: str = "", mentions: list[str] | None = None,
                 account: str = "") -> dict[str, Any]:
    answer = helper("send", {"account": account, "jid": exact_jid(jid),
                             "text": text_argument(text, "text"), "reply_id": reply_to,
                             "mentions": mentions or []}, timeout=120)
    return sent(answer)


@tool("send_files", "Send files",
      "Send up to 10 local files (photos, videos, documents) to one existing chat, with "
      "an optional caption on the first one.",
      {"jid": JID, "paths": {"type": "array", "items": {"type": "string"},
                             "description": "Absolute paths on this computer."},
       "caption": STRING, "reply_to": MESSAGE}, ("jid", "paths"), kind="write")
def send_files(jid: str, paths: list[str], caption: str = "", reply_to: str = "",
               account: str = "") -> dict[str, Any]:
    if not 1 <= len(paths) <= 10:
        raise ToolError("Send 1 to 10 files at a time.")
    files = [str(Path(path).expanduser()) for path in paths]
    missing = [path for path in files if not Path(path).is_file()]
    if missing:
        raise ToolError("These files do not exist: " + ", ".join(missing))
    answer = helper("files", {"account": account, "jid": exact_jid(jid), "paths": files,
                              "caption": text_argument(caption, "caption", False),
                              "reply_id": reply_to}, timeout=600)
    return compact({"done": True, "sent": answer.get("count") or len(files)})


@tool("start_chat", "Message a new number",
      "Send the first message to a phone number you have never messaged. WhatsApp is asked "
      "first whether the number has an account.",
      {"phone": {"type": "string", "description": "With country and area code, e.g. +55 16 99999-0000."},
       "text": STRING}, ("phone", "text"), kind="write")
def start_chat(phone: str, text: str, account: str = "") -> dict[str, Any]:
    digits = digits_of(phone)
    if not 8 <= len(digits) <= 15:
        raise ToolError("Give the full number with country and area code.")
    message = text_argument(text, "text")
    check = helper("check-number", {"account": account, "phone": digits,
                                    "authorization": "remote-read"}, timeout=90)
    if not check.get("registered"):
        raise ToolError("That number has no WhatsApp account. Nothing was sent.")
    answer = helper("send-new", {"account": account, "target": {"phone": digits},
                                 "text": message}, timeout=120)
    return compact({"done": True, "chat_jid": answer.get("chat_jid") or answer.get("jid")})


