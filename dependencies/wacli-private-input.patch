@@ -0,0 +1,17 @@
+package wa
+
+import (
+	"go.mau.fi/whatsmeow/types"
+	"testing"
+)
+
+func TestGroupFallbackDoesNotUseSender(t *testing.T) {
+	for _, server := range []string{types.GroupServer, types.BroadcastServer} {
+		if got := chatNameFallback(types.NewJID("synthetic", server), "Synthetic sender", "fallback"); got != "" {
+			t.Fatalf("group fallback used a sender: %q", got)
+		}
+	}
+	if got := chatNameFallback(types.NewJID("synthetic", types.DefaultUserServer), "Synthetic contact", "fallback"); got != "Synthetic contact" {
+		t.Fatalf("direct message lost its contact name: %q", got)
+	}
+}
