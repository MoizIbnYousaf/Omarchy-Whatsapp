+++ w/cmd/wacli/private_args_test.go
@@ -0,0 +1,32 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestPrivateArgs(t *testing.T) {
+	for _, tc := range []struct {
+		name, input string
+		valid       bool
+	}{
+		{"unicode", `["send","text","--message","Grüße 世界\nline"]`, true},
+		{"empty", `[]`, false}, {"object", `{}`, false}, {"null", `null`, false},
+		{"trailing", `["version"] []`, false}, {"nul", `["a\u0000"]`, false},
+		{"nested", `["--private-args-stdin"]`, false}, {"oversize", strings.Repeat(" ", 65537), false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			args, private, err := readPrivateArgs([]string{privateArgsFlag}, strings.NewReader(tc.input))
+			if !private || (err == nil) != tc.valid {
+				t.Fatalf("private=%v err=%v", private, err)
+			}
+			if tc.valid && len(args) != 4 {
+				t.Fatal("arguments lost")
+			}
+		})
+	}
+	args, private, err := readPrivateArgs([]string{"--version"}, strings.NewReader(""))
+	if err != nil || private || args[0] != "--version" {
+		t.Fatal("ordinary CLI changed")
+	}
+}
diff --git c/cmd/wacli/root.go w/cmd/wacli/root.go
index bfe8f33..018e169 100644
--- c/cmd/wacli/root.go
+++ w/cmd/wacli/root.go
@@ -4,0 +5 @@ import (
+	"errors"
@@ -112,0 +114,11 @@ func writeRootError(flags rootFlags, err error) {
+	if privateInputMode {
+		// Never reflect parser errors or content-bearing remote errors. The
+		// exact lock classification is retained for the caller's existing
+		// pre-dispatch lock handoff; other failures are never retried.
+		message := "Private WhatsApp command failed."
+		if errors.Is(err, lock.ErrLocked) {
+			message = "store is locked"
+		}
+		_ = out.WriteError(os.Stderr, flags.asJSON, fmt.Errorf("%s", message))
+		return
+	}
