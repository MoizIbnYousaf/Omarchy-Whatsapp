diff --git c/cmd/wacli/private_args.go w/cmd/wacli/private_args.go
new file mode 100644
index 0000000..9d4f815
--- /dev/null
+++ w/cmd/wacli/private_args.go
@@ -0,0 +1,52 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+// Private argument transport v1. The OS argv contains only the protocol flag.
+// Normal CLI parsing and all authorization/locking remain in execute().
+var privateInputMode bool
+
+const privateArgsFlag = "--private-args-stdin"
+const privateArgsLimit = 65536
+
+func readPrivateArgs(args []string, input io.Reader) ([]string, bool, error) {
+	if len(args) != 1 || args[0] != privateArgsFlag {
+		return args, false, nil
+	}
+	type result struct {
+		data []byte
+		err  error
+	}
+	done := make(chan result, 1)
+	go func() { data, err := io.ReadAll(io.LimitReader(input, privateArgsLimit+1)); done <- result{data, err} }()
+	var data []byte
+	select {
+	case r := <-done:
+		if r.err != nil {
+			return nil, true, errors.New("private input read failed")
+		}
+		data = r.data
+	case <-time.After(3 * time.Second):
+		return nil, true, errors.New("private input timed out")
+	}
+	if len(data) > privateArgsLimit || !utf8.Valid(data) {
+		return nil, true, errors.New("invalid private input")
+	}
+	var decoded []string
+	if json.Unmarshal(data, &decoded) != nil || len(decoded) == 0 || len(decoded) > 256 {
+		return nil, true, errors.New("invalid private command")
+	}
+	for _, arg := range decoded {
+		if strings.ContainsRune(arg, 0) || arg == privateArgsFlag || arg == "--private-args-version" {
+			return nil, true, errors.New("invalid private argument")
+		}
+	}
+	return decoded, true, nil
+}
