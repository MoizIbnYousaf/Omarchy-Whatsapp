diff --git a/cmd/wacli/omawhatsapp_outcomes.go b/cmd/wacli/omawhatsapp_outcomes.go
new file mode 100644
index 0000000..81cc5d8
--- /dev/null
+++ b/cmd/wacli/omawhatsapp_outcomes.go
@@ -0,0 +1,88 @@
+package main
+
+// OmaWhatsApp downstream extension omawhatsapp.3; not part of upstream wacli.
+// Private-mode callers see no error text, so a failed delegated request needs
+// a fixed, content-free outcome: refused before dispatch (not sent), or
+// dispatched without a confirmed result (may have gone through).
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"time"
+)
+
+// Printed by --private-args-version. Callers match protocol and max_bytes and
+// ignore other keys, so the build label stays compatible with older probes.
+const privateArgsCapability = `{"protocol":1,"max_bytes":65536,"build":"omawhatsapp.3"}`
+
+const (
+	privateNotSentMessage   = "Private WhatsApp command was not sent."
+	privateUncertainMessage = "Private WhatsApp command outcome is unknown."
+)
+
+// The bypass refusal uses upstream's wording for its own app-state bypass.
+const delegateBypassRefusal = "request deadline passed before dispatch; it was not sent"
+
+var (
+	errDelegateNotSent        = errors.New("delegated request was not sent")
+	errDelegateOutcomeUnknown = errors.New("delegated request outcome is unknown")
+)
+
+// The daemon's exact pre-dispatch refusals. Matching whole messages keeps an
+// operation's own error text from ever reading as "not sent".
+var delegateRefusals = map[string]bool{
+	"request timed out in the send queue before dispatch; it was not sent":   true,
+	"send spacing exceeded request timeout before dispatch; it was not sent": true,
+	delegateBypassRefusal: true,
+}
+
+const delegateUncertainMarker = " failed after dispatch and may still have gone through; check before retrying: "
+
+type delegateOutcomeError struct {
+	err     error
+	outcome error
+}
+
+func (e delegateOutcomeError) Error() string   { return e.err.Error() }
+func (e delegateOutcomeError) Unwrap() []error { return []error{e.err, e.outcome} }
+
+// delegateFailure keeps the daemon's message and marks the outcome it states.
+func delegateFailure(message string) error {
+	err := errors.New(message)
+	switch {
+	case strings.HasPrefix(message, "delegated ") && strings.Contains(message, delegateUncertainMarker):
+		return delegateOutcomeError{err: err, outcome: errDelegateOutcomeUnknown}
+	case delegateRefusals[message]:
+		return delegateOutcomeError{err: err, outcome: errDelegateNotSent}
+	}
+	return err
+}
+
+// privateOutcomeMessage returns a fixed outcome, or "" for an ordinary failure.
+// Any deadline or timeout is uncertain: the request may already be on the wire.
+func privateOutcomeMessage(err error) string {
+	var netErr net.Error
+	switch {
+	case errors.Is(err, errDelegateOutcomeUnknown),
+		errors.Is(err, context.DeadlineExceeded),
+		errors.Is(err, context.Canceled),
+		errors.As(err, &netErr) && netErr.Timeout():
+		return privateUncertainMessage
+	case errors.Is(err, errDelegateNotSent):
+		return privateNotSentMessage
+	}
+	return ""
+}
+
+// One send attempt's own 45s deadline can expire after the message frame was
+// written, inside a longer command budget. Keep upstream's text, but let it
+// count as a deadline so delegated and direct sends report it as uncertain.
+type sendAttemptTimeoutError struct{ timeout time.Duration }
+
+func (e sendAttemptTimeoutError) Error() string {
+	return fmt.Sprintf("send timed out after %s", e.timeout)
+}
+func (e sendAttemptTimeoutError) Unwrap() error { return context.DeadlineExceeded }
diff --git a/cmd/wacli/omawhatsapp_outcomes_test.go b/cmd/wacli/omawhatsapp_outcomes_test.go
