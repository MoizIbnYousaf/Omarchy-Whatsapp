+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/lock"
+)
+
+// OmaWhatsApp downstream regressions: private-mode callers must still learn
+// whether a failed delegated request was sent. Executors are synthetic.
+
+const omaSyntheticContent = "SYNTHETIC private text +15550000000"
+
+func TestOmaPrivateArgsCapabilityNamesBuild(t *testing.T) {
+	var capability map[string]any
+	if err := json.Unmarshal([]byte(privateArgsCapability), &capability); err != nil {
+		t.Fatal(err)
+	}
+	if capability["protocol"] != float64(1) || capability["max_bytes"] != float64(privateArgsLimit) || capability["build"] != "omawhatsapp.3" {
+		t.Fatalf("capability = %v", capability)
+	}
+}
+
+func TestOmaPrivateOutcomeClassification(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		err  error
+		want string
+	}{
+		{"queue refusal", delegateFailure("request timed out in the send queue before dispatch; it was not sent"), privateNotSentMessage},
+		{"paced refusal", delegateFailure("send spacing exceeded request timeout before dispatch; it was not sent"), privateNotSentMessage},
+		{"bypass refusal", delegateFailure(delegateBypassRefusal), privateNotSentMessage},
+		{"after dispatch", delegateFailure("delegated text failed after dispatch and may still have gone through; check before retrying: context deadline exceeded"), privateUncertainMessage},
+		{"caller deadline", fmt.Errorf("send: %w", context.DeadlineExceeded), privateUncertainMessage},
+		{"attempt deadline", sendAttemptTimeoutError{timeout: 45 * time.Second}, privateUncertainMessage},
+		{"socket timeout", fmt.Errorf("no reply: %w", os.ErrDeadlineExceeded), privateUncertainMessage},
+		{"content not a refusal", delegateFailure(omaSyntheticContent + "; it was not sent"), ""},
+		{"ordinary failure", delegateFailure(omaSyntheticContent), ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := privateOutcomeMessage(tc.err); got != tc.want {
+				t.Fatalf("outcome = %q, want %q", got, tc.want)
+			}
+		})
+	}
+	if got := (sendAttemptTimeoutError{timeout: 20 * time.Millisecond}).Error(); got != "send timed out after 20ms" {
+		t.Fatalf("attempt timeout text changed: %q", got)
+	}
+}
+
+func omaDelegateServer(t *testing.T, execute sendDelegateExecutor) string {
+	t.Helper()
+	skipPresenceDelegateSocketTestOnUnsupportedOS(t)
+	dir := shortPresenceDelegateStoreDir(t)
+	stop, err := startSendDelegateServerForStore(context.Background(), dir, sendSpacing{}, execute)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(stop)
+	return dir
+}
+
+func TestOmaQueuedRefusalReportsNotSent(t *testing.T) {
+	release := make(chan struct{})
+	started := make(chan struct{}, 1)
+	dir := omaDelegateServer(t, func(ctx context.Context, req sendDelegateRequest) (sendDelegateResponse, error) {
+		if req.Message == "slow" {
+			started <- struct{}{}
+			<-release
+		}
+		return sendDelegateResponse{OK: true, Sent: true}, nil
+	})
+	slow := make(chan struct{})
+	go func() {
+		defer close(slow)
+		_, _ = delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 5 * time.Second}, sendDelegateRequest{Kind: "text", Message: "slow"})
+	}()
+	<-started
+	_, err := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: sendDelegateReplyMargin + 300*time.Millisecond}, sendDelegateRequest{Kind: "text", Message: omaSyntheticContent})
+	close(release)
+	<-slow
+	if err == nil || !strings.Contains(err.Error(), "it was not sent") {
+		t.Fatalf("queued error = %v, want upstream's refusal text", err)
+	}
+	if got := privateOutcomeMessage(err); got != privateNotSentMessage {
+		t.Fatalf("private outcome = %q", got)
+	}
+}
+
+func TestOmaExpiredReadMarkBypassReportsNotSent(t *testing.T) {
+	serverConn, clientConn := net.Pipe()
+	defer clientConn.Close()
+	sendSlot := make(chan struct{}, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		handleSendDelegateConn(context.Background(), serverConn, unexpectedExecute(t), sendSlot, newSendPacer(sendSpacing{}))
+	}()
+	resp := roundTripDelegate(t, clientConn, sendDelegateRequest{
+		Version: sendDelegateVersion, Kind: markReadKind, TimeoutMS: 10000,
+		DeadlineUnixMS: time.Now().Add(-time.Second).UnixMilli(),
+	})
+	<-done
+	if resp.OK || privateOutcomeMessage(delegateFailure(resp.Error)) != privateNotSentMessage {
+		t.Fatalf("expired read mark response: %+v", resp)
+	}
+}
+
+func TestOmaDispatchedDeadlineReportsUncertain(t *testing.T) {
+	dir := omaDelegateServer(t, func(ctx context.Context, _ sendDelegateRequest) (sendDelegateResponse, error) {
+		<-ctx.Done()
+		return sendDelegateResponse{}, ctx.Err()
+	})
+	_, err := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: time.Second}, sendDelegateRequest{Kind: "text"})
+	if got := privateOutcomeMessage(err); got != privateUncertainMessage {
+		t.Fatalf("outcome = %q for %v", got, err)
+	}
+}
+
+func TestOmaAttemptTimeoutInsideLargerBudgetReportsUncertain(t *testing.T) {
+	wrote := make(chan struct{}, 1)
+	dir := omaDelegateServer(t, func(ctx context.Context, _ sendDelegateRequest) (sendDelegateResponse, error) {
+		// The frame is written; the acknowledgement outlives this attempt
+		// while the request's own budget is still live.
+		return runSendAttempt(ctx, 50*time.Millisecond, func(ctx context.Context) (sendDelegateResponse, error) {
+			wrote <- struct{}{}
+			<-ctx.Done()
+			return sendDelegateResponse{}, ctx.Err()
+		})
+	})
+	_, err := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 5 * time.Second}, sendDelegateRequest{Kind: "file"})
+	<-wrote
+	if err == nil || !strings.Contains(err.Error(), "may still have gone through") {
+		t.Fatalf("error = %v, want an uncertain outcome", err)
+	}
+	if got := privateOutcomeMessage(err); got != privateUncertainMessage {
+		t.Fatalf("outcome = %q", got)
+	}
+}
+
+func TestOmaUnansweredDelegateReportsUncertain(t *testing.T) {
+	skipPresenceDelegateSocketTestOnUnsupportedOS(t)
+	dir := shortPresenceDelegateStoreDir(t)
+	ln, err := net.Listen("unix", sendDelegateSocketPath(dir))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		var req sendDelegateRequest
+		_ = json.NewDecoder(conn).Decode(&req)
+		time.Sleep(time.Second)
+	}()
+	_, err = delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 200 * time.Millisecond}, sendDelegateRequest{Kind: "text"})
+	if got := privateOutcomeMessage(err); got != privateUncertainMessage {
+		t.Fatalf("outcome = %q for %v", got, err)
+	}
+}
+
+func TestOmaOrdinaryDelegateFailureStaysGeneric(t *testing.T) {
+	dir := omaDelegateServer(t, func(context.Context, sendDelegateRequest) (sendDelegateResponse, error) {
+		return sendDelegateResponse{}, errors.New(omaSyntheticContent)
+	})
+	_, err := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: time.Second}, sendDelegateRequest{Kind: "text"})
+	if err == nil || privateOutcomeMessage(err) != "" {
+		t.Fatalf("ordinary failure classified: %v", err)
+	}
+}
+
+// The actual private-mode stderr envelope carries only the fixed text.
+func TestOmaPrivateRootErrorCarriesOnlyFixedOutcome(t *testing.T) {
+	socket := sendDelegateSocketPath(t.TempDir())
+	for _, tc := range []struct {
+		err  error
+		want string
+	}{
+		{fmt.Errorf("no reply from %s (%s): %w", socket, omaSyntheticContent, os.ErrDeadlineExceeded), privateUncertainMessage},
+		{delegateFailure("request timed out in the send queue before dispatch; it was not sent"), privateNotSentMessage},
+		{fmt.Errorf("%s: %w", socket, lock.ErrLocked), "store is locked"},
+		{fmt.Errorf("%s at %s", omaSyntheticContent, socket), "Private WhatsApp command failed."},
+	} {
+		got := omaCapturePrivateRootError(t, tc.err)
+		var envelope struct {
+			Success bool   `json:"success"`
+			Error   string `json:"error"`
+		}
+		if err := json.Unmarshal([]byte(got), &envelope); err != nil || envelope.Success || envelope.Error != tc.want {
+			t.Fatalf("stderr = %q, want error %q", got, tc.want)
+		}
+		if strings.Contains(got, socket) || strings.Contains(got, "SYNTHETIC") {
+			t.Fatalf("private error leaked detail: %q", got)
+		}
+	}
+}
+
+func omaCapturePrivateRootError(t *testing.T, err error) string {
+	t.Helper()
+	reader, writer, pipeErr := os.Pipe()
+	if pipeErr != nil {
+		t.Fatal(pipeErr)
+	}
+	stderr, mode := os.Stderr, privateInputMode
+	os.Stderr, privateInputMode = writer, true
+	writeRootError(rootFlags{asJSON: true}, err)
+	os.Stderr, privateInputMode = stderr, mode
+	_ = writer.Close()
+	data, readErr := io.ReadAll(reader)
+	_ = reader.Close()
+	if readErr != nil {
+		t.Fatal(readErr)
+	}
+	return strings.TrimSpace(string(data))
+}
diff --git a/cmd/wacli/omawhatsapp_send_latency_test.go b/cmd/wacli/omawhatsapp_send_latency_test.go
