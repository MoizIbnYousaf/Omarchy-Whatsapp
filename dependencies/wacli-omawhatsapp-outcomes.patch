+++ b/cmd/wacli/omawhatsapp_send_latency_test.go
@@ -0,0 +1,137 @@
+package main
+
+import (
+	"context"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// OmaWhatsApp downstream regressions, originally by Brunno Vert (PR #28).
+// Executors are synthetic: no account, database, or WhatsApp connection.
+
+// A slow app-state repair must not take the slot needed by an interactive send.
+func TestOmaReadMarkDoesNotBlockSend(t *testing.T) {
+	skipPresenceDelegateSocketTestOnUnsupportedOS(t)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	dir := shortPresenceDelegateStoreDir(t)
+	stop, err := startSendDelegateServerForStore(context.Background(), dir, sendSpacing{}, func(ctx context.Context, req sendDelegateRequest) (sendDelegateResponse, error) {
+		if req.Kind == markReadKind {
+			close(entered)
+			<-release
+			return sendDelegateResponse{OK: true}, nil
+		}
+		return sendDelegateResponse{OK: true, Sent: true}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		_, _ = delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 2 * time.Second}, sendDelegateRequest{Kind: markReadKind})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		close(release)
+		t.Fatal("read mark never started")
+	}
+	started := time.Now()
+	response, sendErr := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 300 * time.Millisecond}, sendDelegateRequest{Kind: "text"})
+	close(release)
+	<-finished
+	if sendErr != nil || !response.Sent {
+		t.Fatalf("send was held by slow read mark (%s): %v", time.Since(started), sendErr)
+	}
+	if time.Since(started) > 250*time.Millisecond {
+		t.Fatal("interactive send waited for app state")
+	}
+}
+
+// Receipt-mode read marks never enter app-state recovery, so they keep the
+// send slot (and its pacing), as upstream does.
+func TestOmaReceiptReadMarkStaysInSendQueue(t *testing.T) {
+	skipPresenceDelegateSocketTestOnUnsupportedOS(t)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var texts atomic.Int32
+	dir := shortPresenceDelegateStoreDir(t)
+	stop, err := startSendDelegateServerForStore(context.Background(), dir, sendSpacing{}, func(ctx context.Context, req sendDelegateRequest) (sendDelegateResponse, error) {
+		if req.Kind == markReadReceiptsKind {
+			close(entered)
+			<-release
+			return sendDelegateResponse{OK: true}, nil
+		}
+		texts.Add(1)
+		return sendDelegateResponse{OK: true, Sent: true}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		_, _ = delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 2 * time.Second}, sendDelegateRequest{Kind: markReadReceiptsKind})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		close(release)
+		t.Fatal("receipt read mark never started")
+	}
+	_, sendErr := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: sendDelegateReplyMargin + 300*time.Millisecond}, sendDelegateRequest{Kind: "text"})
+	close(release)
+	<-finished
+	if sendErr == nil || !strings.Contains(sendErr.Error(), "it was not sent") {
+		t.Fatalf("send did not queue behind the receipt read mark: %v", sendErr)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if got := texts.Load(); got != 0 {
+		t.Fatalf("queued send ran beside the receipt read mark: executions=%d", got)
+	}
+}
+
+func TestOmaExpiredQueuedSendIsNotDispatched(t *testing.T) {
+	skipPresenceDelegateSocketTestOnUnsupportedOS(t)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var executed atomic.Int32
+	dir := shortPresenceDelegateStoreDir(t)
+	stop, err := startSendDelegateServerForStore(context.Background(), dir, sendSpacing{}, func(ctx context.Context, req sendDelegateRequest) (sendDelegateResponse, error) {
+		if executed.Add(1) == 1 {
+			close(entered)
+			<-release
+		}
+		return sendDelegateResponse{OK: true, Sent: true}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		_, _ = delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 2 * time.Second}, sendDelegateRequest{Kind: "text"})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		close(release)
+		t.Fatal("first send never started")
+	}
+	_, queuedErr := delegateSend(context.Background(), &rootFlags{storeDir: dir, timeout: 100 * time.Millisecond}, sendDelegateRequest{Kind: "text"})
+	close(release)
+	<-finished
+	time.Sleep(50 * time.Millisecond)
+	if queuedErr == nil || !strings.Contains(queuedErr.Error(), "it was not sent") {
+		t.Errorf("missing pre-dispatch refusal: %v", queuedErr)
+	}
+	if got := executed.Load(); got != 1 {
+		t.Errorf("expired queued send ran late: executions=%d", got)
+	}
+}
